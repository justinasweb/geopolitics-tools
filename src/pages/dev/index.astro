---
// The development index at /dev: every built page, for clicking through local and Preview builds. Not linked from
// the site, noindex, disallowed in robots.txt like the other development pages.
import Page from '../../layouts/Page.astro';
import { routes, type Route } from '../../lib/routes';
import { DOSSIERS } from '../../lib/country';

const built = routes().filter((r) => r.live);
const of = (kind: Route['kind']) => built.filter((r) => r.kind === kind);
const groups: { title: string; items: Route[] }[] = [
  { title: 'Indexes and long reads', items: [...of('countries'), ...of('indicators'), ...of('sources'), ...of('page')] },
  { title: 'Topic hubs', items: of('hub') },
  { title: 'Map views', items: of('view') },
  { title: 'Country pages with an AI summary', items: of('country').filter((r) => DOSSIERS.includes(r.id)) },
  { title: 'Compare', items: of('compare') },
  { title: 'Indicators', items: of('indicator') },
];
const dev = ['/dev/components', '/dev/map', '/does-not-exist'];
const notLive = routes().filter((r) => !r.live).length;
---
<Page title="Development index" description="Every page built so far, for local and Preview builds." noindex fromData={false}>
  <header class="dx-head">
    <span class="gt-kicker">Local and Preview builds only</span>
    <h1 class="gt-title">Development index</h1>
    <p class="gt-lede">Every page built so far. The homepage is at <a href="/">/</a>; in production that address shows the holding page until launch. {of('country').length} country pages in all (through Countries); {notLive} registered pages are not built yet.</p>
  </header>
  {groups.filter((g) => g.items.length).map((g) => (
    <section class="dx-group">
      <h2>{g.title} <span>{g.items.length}</span></h2>
      <ul>{g.items.map((r) => <li><a href={r.path}>{r.path}</a></li>)}</ul>
    </section>
  ))}
  <section class="dx-group">
    <h2>Development pages</h2>
    <ul>{dev.map((p) => <li><a href={p}>{p}</a></li>)}</ul>
  </section>
</Page>

<style>
  .dx-head { display: grid; gap: 12px; padding: 40px 0 24px; }
  .dx-group { border-top: 1px solid var(--rule); padding: 16px 0 24px; }
  .dx-group h2 { margin: 0 0 12px; font: 600 13px/18px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); }
  .dx-group h2 span { font-weight: 400; }
  .dx-group ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 4px 24px; }
  .dx-group a { display: inline-flex; align-items: center; min-height: 32px; font: 400 15px/22px var(--sans); overflow-wrap: anywhere; }
</style>
