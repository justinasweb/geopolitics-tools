---
// Every generated page, from the route registry (src/lib/routes.ts): the path comes from the registry, the
// template from the route's kind. Routes that are not live yet (map views, hubs, tools) are not built.
import type { GetStaticPaths } from 'astro';
import CountriesIndex from '../templates/CountriesIndex.astro';
import CountryPage from '../templates/CountryPage.astro';
import ComparePage from '../templates/ComparePage.astro';
import IndicatorsIndex from '../templates/IndicatorsIndex.astro';
import IndicatorPage from '../templates/IndicatorPage.astro';
import LongRead from '../templates/LongRead.astro';
import SourcesPage from '../templates/SourcesPage.astro';
import MineralView from '../templates/MineralView.astro';
import IndicatorView from '../templates/IndicatorView.astro';
import DisasterView from '../templates/DisasterView.astro';
import FoodView from '../templates/FoodView.astro';
import EnergyView from '../templates/EnergyView.astro';
import ConflictView from '../templates/ConflictView.astro';
import BlocView from '../templates/BlocView.astro';
import HistoryView from '../templates/HistoryView.astro';
import RiverView from '../templates/RiverView.astro';
import ExplorerPage from '../templates/ExplorerPage.astro';
import DependenciesPage from '../templates/DependenciesPage.astro';
import SupplyChainPage from '../templates/SupplyChainPage.astro';
import SupplyChainsIndex from '../templates/SupplyChainsIndex.astro';
import BlocOverlapPage from '../templates/BlocOverlapPage.astro';
import AtlasPage from '../templates/AtlasPage.astro';
import { BUILT_KINDS, routes, type Route } from '../lib/routes';
import type { View } from '../lib/explorer/model';

export const getStaticPaths = (() =>
  routes().filter((r) => r.live && BUILT_KINDS.includes(r.kind))
    .map((r) => ({ params: { path: r.path.slice(1) }, props: { route: r } }))) satisfies GetStaticPaths;

const { route } = Astro.props as { route: Route };
const [a, b] = route.id.split(',');
---
{route.kind === 'countries' && <CountriesIndex />}
{route.kind === 'country' && <CountryPage id={route.id} />}
{route.kind === 'compare' && <ComparePage a={a} b={b} />}
{route.kind === 'indicators' && <IndicatorsIndex />}
{route.kind === 'indicator' && <IndicatorPage id={route.id} />}
{route.kind === 'page' && <LongRead id={route.id} />}
{route.kind === 'sources' && <SourcesPage />}
{route.kind === 'view' && route.id.startsWith('minerals:') && <MineralView id={route.id.slice('minerals:'.length)} />}
{route.kind === 'view' && route.id.startsWith('disasters:') && <DisasterView id={route.id.split(':')[1]} />}
{route.kind === 'view' && route.id.startsWith('food:') && <FoodView id={route.id.split(':')[1]} />}
{route.kind === 'view' && route.id.startsWith('blocs:') && <BlocView id={route.id.split(':')[1]} />}
{route.kind === 'view' && route.id.startsWith('history:') && <HistoryView id={route.id.split(':')[1]} />}
{route.kind === 'view' && route.id.startsWith('rivers:') && <RiverView id={route.id.split(':')[1]} />}
{route.kind === 'view' && route.id.startsWith('energy:') && <EnergyView id={route.id.split(':')[1]} />}
{route.kind === 'view' && route.id.startsWith('conflict:') && <ConflictView />}
{route.kind === 'view' && !/^(minerals|disasters|food|energy|conflict|blocs|history|rivers):/.test(route.id) && <IndicatorView id={route.id.split(':')[1]} />}
{route.kind === 'tool' && route.id.startsWith('explorer:') && <ExplorerPage view={route.id.split(':')[1] as View} />}
{route.kind === 'tool' && route.id === 'dependencies' && <DependenciesPage />}
{route.kind === 'tool' && route.id === 'supply-chains' && <SupplyChainsIndex />}
{route.kind === 'tool' && route.id.startsWith('supply-chains:') && <SupplyChainPage flow={route.id.split(':')[1]} />}
{route.kind === 'tool' && route.id === 'blocs-overlap' && <BlocOverlapPage />}
{route.kind === 'tool' && route.id === 'atlas' && <AtlasPage />}
