---
// The home page. Until launch, production (SITE_HOLDING=true) serves the holding page (src/holding/index.html, one
// self-contained file from the Brand directions work) as-is, plus the site-wide noindex tag while the site is not
// indexable. Local and Preview builds show the homepage (src/templates/HomePage.astro); the development index of
// every built page is at /dev.
import HomePage from '../templates/HomePage.astro';
import holding from '../holding/index.html?raw';
import { fathomTag, holdingHome, indexable } from '../lib/site';
import { hashRedirectScript } from '../lib/routes';

if (holdingHome) {
  // Old prototype links (/#/country/RUS) land here; move them to their pages.
  const withHash = holding.replace('<head>', `<head>\n<script>${hashRedirectScript()}</script>`);
  const tagged = withHash.replace('</head>', `${fathomTag}\n</head>`);
  const html = indexable ? tagged : tagged.replace('<head>', '<head>\n<meta name="robots" content="noindex">');
  return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}
---
<HomePage />
