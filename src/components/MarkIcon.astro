---
// A map mark's shape, drawn as the map draws it (src/scripts/map/engine.ts), for legends and lists: a shape, so a
// mark never relies on colour alone. The shapes are defined once in src/scripts/map/legend.ts, which the Atlas's
// legends also use.
import { markSvg, type MarkSymbol } from '../scripts/map/legend';
interface Props { symbol: MarkSymbol }
const { symbol } = Astro.props;
---
<Fragment set:html={markSvg(symbol)} />
