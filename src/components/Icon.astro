---
// Line icons on a 24 grid (1.8 stroke, round caps, currentColor, styled by .gt-ico), the small 12-grid glyphs used
// inside tags, chips and changes, and the two platform marks (X and Telegram) for the share row and footer only.
// Always decorative: the control around an icon carries the words.
const LINE = {
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M5 5l14 14M19 5 5 19"/>',
  copy: '<rect x="8" y="8" width="12" height="12"/><path d="M16 8V4H4v12h4"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3.5-3.5a4 4 0 0 0-5.7-5.7L12 6.3"/><path d="M14 10a4 4 0 0 0-5.7 0l-3.5 3.5a4 4 0 0 0 5.7 5.7l1.5-1.5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  alert: '<path d="M12 3 2 20h20z"/><path d="M12 10v4.5M12 17.2v.3"/>',
  empty: '<rect x="3" y="4" width="18" height="16"/><path d="M3 9h18M8 14h8"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M4 20h16"/>',
} as const;

const SMALL = {
  chevron: '<path d="M2.5 4.5 6 8l3.5-3.5"/>',
  check: '<path d="M2 6.5 5 9.5 10 3"/>',
  up: '<path d="M6 10V2M2.5 5.5 6 2l3.5 3.5"/>',
  down: '<path d="M6 2v8M2.5 6.5 6 10l3.5-3.5"/>',
  flat: '<path d="M2 6h8"/>',
} as const;

const MARK = {
  x: '<path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"/>',
  telegram: '<path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.2l-4.7-1.5c-1-.3-1-1 .2-1.5L20.5 3.1c.9-.3 1.6.2 1.4 1.2z"/>',
} as const;

export type IconName = keyof typeof LINE | keyof typeof SMALL | keyof typeof MARK;

interface Props {
  name: IconName;
  /** Extra class. Line icons get gt-ico unless `bare` is set (when the container styles the svg itself). */
  class?: string;
  bare?: boolean;
}
const { name, class: cls, bare = false } = Astro.props;
const svg = name in LINE
  ? { viewBox: '0 0 24 24', body: LINE[name as keyof typeof LINE], class: [bare ? '' : 'gt-ico', cls].filter(Boolean).join(' ') }
  : name in SMALL
    ? { viewBox: '0 0 12 12', body: SMALL[name as keyof typeof SMALL], class: cls }
    : { viewBox: '0 0 24 24', body: MARK[name as keyof typeof MARK], class: ['fill', cls].filter(Boolean).join(' ') };
---
<svg class={svg.class || undefined} viewBox={svg.viewBox} aria-hidden="true" set:html={svg.body} />
