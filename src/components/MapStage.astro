---
// The heart of every map view (MapStage design): the map with its zoom buttons, bloc chip and legend on the left,
// the panel on the right. One component serves every view; a view supplies its layer file, legend and the world
// panel (slot "panel", one [data-panel="world"] block). Everything but the canvas is in the HTML, so the panel, the
// legend and the page read the same before and without the map script. On a phone the panel reads inline and the
// map opens full screen from "Show map" (PhoneMapView design).
import '../styles/atlas/mapview.css';
import '../styles/atlas/panel.css';
import '../styles/atlas/legend.css';
import '../styles/atlas/tooltip.css';
import '../styles/atlas/tags.css';
import Icon from './Icon.astro';
import MarkIcon from './MarkIcon.astro';
import { MAP_TEXT } from '../i18n/map.en';
import { paths } from '../lib/routes';

interface Props {
  /** The layer file (/map/<id>.json). */
  layer: string;
  /** What the map shows, for screen readers: the same figures are in the table. */
  label: string;
  /** The view's name, for the phone map's top bar. */
  title: string;
  legend: { title: string; scale: 'seq' | 'div'; ticks: string[]; ends?: [string, string]; none: string; withheld?: boolean; notyet?: string; marks?: { symbol: 'dot' | 'hollow' | 'triangle' | 'diamond' | 'square' | 'arc'; label: string }[];
    /** Named classes in place of a scale (a bloc's members): each a sequential class and its word. */
    categories?: { cls: number; label: string }[] };
  basemap?: string;
}
const { layer, label, title, legend, basemap = '/geo/basemap.json' } = Astro.props;
const n = legend.scale === 'seq' ? 5 : 7;
---
<div class="gt-stage" data-gt-map data-layer={layer} data-basemap={basemap}>
  <div class="gt-stage__map">
    <div class="gt-maphost">
      <div class="gt-mapcanvas" aria-label={label} aria-describedby="mv-keys"></div>
      <p class="gt-vh" id="mv-keys">{MAP_TEXT.keys}</p>
      <div class="gt-mapstate" data-map-state="loading"><p class="gt-mapstate__msg">{MAP_TEXT.loading}</p></div>
      <div class="gt-mapstate" data-map-state="error" hidden>
        <div class="gt-mapstate__err" role="alert">
          <p class="gt-mapstate__msg"><Icon name="alert" />{MAP_TEXT.failed}</p>
          <p><button class="gt-btn gt-btn--quiet" type="button" data-map-retry>{MAP_TEXT.retry}</button> <a href="#table">{MAP_TEXT.seeTable}</a></p>
        </div>
      </div>
      <div class="gt-zoom" role="group" aria-label={MAP_TEXT.zoom}>
        <button type="button" aria-label={MAP_TEXT.zoomIn} data-zoom="in">+</button>
        <button type="button" aria-label={MAP_TEXT.zoomOut} data-zoom="out">−</button>
        <button type="button" aria-label={MAP_TEXT.reset} data-zoom="reset"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.5-3.5M3 2.5V5h2.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
      </div>
      <div class="gt-blocchip" hidden data-bloc-chip>
        <span class="gt-blocchip__key" aria-hidden="true"></span><span data-bloc-name></span><small data-bloc-count></small>
        <button type="button" data-bloc-remove><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      </div>
      <div class="gt-stage__leg">
        <div class="gt-legend gt-mapleg">
          <span class="gt-legend__title" data-legend-title>{legend.title}</span>
          {legend.categories ? (
            <div class="gt-legend__extra gt-legend__cats">{legend.categories.map((c) => <span><i class="gt-sw" style={`background:var(--seq-${c.cls})`}></i>{c.label}</span>)}</div>
          ) : (
            <>
              <div class="gt-legend__scale" style={`--n:${n}`}>{Array.from({ length: n }, (_, i) => <i style={`background:var(--${legend.scale}-${i + 1})`}></i>)}</div>
              <div class:list={['gt-legend__ticks', { 'gt-legend__ticks--dense': legend.scale === 'div' }]} style={`--n:${n}`}>{legend.ticks.map((t) => <span>{t}</span>)}</div>
            </>
          )}
          {legend.ends && <div class="gt-legend__ends"><span>← {legend.ends[0]}</span><span>{legend.ends[1]} →</span></div>}
          <div class="gt-legend__extra">
            <span><i class="gt-sw gt-sw--nodata"></i>{legend.none}</span>
            {legend.withheld && <span><i class="gt-sw gt-sw--withheld"></i>{MAP_TEXT.withheldBy}</span>}
            {legend.notyet && <span><i class="gt-sw gt-sw--notyet"></i>{legend.notyet}</span>}
          </div>
          {legend.marks && legend.marks.length > 0 && <div class="gt-legend__extra gt-legend__marks">{legend.marks.map((m) => <span><MarkIcon symbol={m.symbol} />{m.label}</span>)}</div>}
        </div>
        <p class="gt-stage__borders"><i aria-hidden="true"></i>{MAP_TEXT.borders} <a href={paths.page('methodology')}>{MAP_TEXT.howBorders}</a></p>
      </div>
      <div class="gt-tip gt-world__tip" hidden aria-hidden="true"></div>
      <section class="gt-sheet gt-mvsheet" hidden aria-live="polite" data-map-sheet></section>
    </div>
  </div>
  <aside class="gt-panel gt-mvpanel" aria-label={MAP_TEXT.panel}>
    <slot name="panel" />
    <div data-panel="country" hidden aria-live="polite"></div>
    <button class="gt-btn gt-mvfirst__map" type="button" aria-haspopup="dialog" data-show-map><Icon name="map" />{MAP_TEXT.showMap}</button>
  </aside>
  <dialog class="gt-mapfull" aria-label={title} data-mapfull>
    <div class="gt-mapfull__bar">
      <button class="gt-iconbtn" type="button" aria-label={MAP_TEXT.closeMap} data-close-map><Icon name="close" /></button>
      <div class="gt-mapfull__t"><b>{title}</b><span data-legend-title>{legend.title}</span></div>
    </div>
    <div class="gt-mapfull__map"></div>
  </dialog>
</div>

<script>
  import { initMapView } from '../scripts/map/view';
  document.querySelectorAll<HTMLElement>('[data-gt-map]').forEach(initMapView);
</script>
