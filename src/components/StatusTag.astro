---
// Labels a number that is not a final, reported actual. Each status has its own glyph and word, so colour is never
// the only cue. "sample" marks an illustrative figure; the production build fails if one ships (scripts/check-dist.mjs).
import '../styles/atlas/tags.css';
import { STATUS_TEXT } from '../i18n/en';
import { GLYPH, type Status } from '../lib/tags';

export type { Status };

interface Props { status: Status; small?: boolean }
const { status, small = false } = Astro.props;
---
<span class:list={['gt-tag', `gt-tag--${status}`, { 'gt-tag--sm': small }]} title={status === 'sample' ? STATUS_TEXT.sampleTitle : undefined}><svg viewBox="0 0 12 12" aria-hidden="true" set:html={GLYPH[status]} />{STATUS_TEXT[status]}</span>
