---
// GDACS alerts on This week (.gt-alerts): the level as a word and a shape (red a solid triangle, orange an outline),
// the kind and the first three countries, the rest behind a "+ 11 more" disclosure (a native <details>, so it opens
// by keyboard and without scripts), and the date it began.
import '../styles/atlas/week.css';
import type { AlertRow } from '../lib/week';
import { list } from '../i18n/pages.en';
import { WEEK_TEXT as W } from '../i18n/week.en';

interface Props { rows: AlertRow[] }
const { rows } = Astro.props;
const SOLID = '<path d="M6 1.2 11.2 10.6H.8z"/>';
const OUTLINE = '<path d="M6 2.2 10.4 10H1.6z" fill="none" stroke="currentColor" stroke-width="1.6"/>';
// Each country is its own inline-block (.gt-alerts__place), so the column wraps between names and a name that fits
// stays on one line ("Central African Republic"); one too long for the column wraps inside its own box. The word
// joiner keeps "+ 10 more" on the line of the last name shown.
const JOIN = '\u2060';
// The joiner before a list's last name, from the same list() the rest of the page uses ("and").
const AND = list(['', '']).trim();
---
<ul class="gt-alerts">
  {rows.map((r) => (
    <li>
      <span class:list={['gt-alerts__lvl', `gt-alerts__lvl--${r.level}`]}><svg viewBox="0 0 12 12" aria-hidden="true" set:html={r.level === 'red' ? SOLID : OUTLINE} />{r.levelText}</span>
      <span class="gt-alerts__what">
        {r.what}{r.places.length > 0 && ', '}
        {r.places.map((p, i) => {
          const last = i === r.places.length - 1;
          const andNext = !r.more && i === r.places.length - 2;
          return <>{i > 0 && ' '}<span class="gt-alerts__place">{p}{!last && !andNext && ','}{last && r.more && <>{JOIN}<details class="gt-alerts__more"><summary><span class="gt-alerts__count">{r.more.text}<span class="gt-vh"> {r.more.label}</span></span><span class="gt-alerts__fewer">{W.fewerPlaces}</span></summary><span>{r.more.places}</span></details></>}</span>{andNext && ` ${AND}`}</>;
        })}
        {r.note && <small class="gt-alerts__note">{r.note}</small>}
      </span>
      <span class="gt-alerts__date tnum">{r.date}</span>
    </li>
  ))}
</ul>
