---
// The chart or table inside a WeekCard, from the page model (src/lib/week.ts): the alert list (./AlertList.astro),
// with the alerts still active from earlier under "Still active", paired bars for the latest month against the one before (.gt-pair, the earlier
// month an outline bar), or a compact table (prices with arrows, outages, sanctions lists), then its notes.
import '../styles/atlas/week.css';
import '../styles/atlas/table.css';
import AlertList from './AlertList.astro';
import type { Body } from '../lib/week';

interface Props { body: Body }
const { body } = Astro.props;
const UP = '<path d="M6 10V2M2.5 5.5 6 2l3.5 3.5"/>';
const DOWN = '<path d="M6 2v8M2.5 6.5 6 10l3.5-3.5"/>';
const FLAT = '<path d="M2 6h8"/>';
---
{body.type === 'alerts' && (body.rows.length > 0 ? <AlertList rows={body.rows} /> : body.empty && <p class="gt-caption">{body.empty}</p>)}
{body.type === 'alerts' && body.active.length > 0 && (
  <div class="gt-alerts__still">
    <h4 class="gt-label">{body.activeTitle}</h4>
    <p class="gt-caption">{body.activeNote}</p>
    <AlertList rows={body.active} />
    {body.activeMore && <p class="gt-caption">{body.activeMore}</p>}
  </div>
)}
{body.type === 'pair' && body.rows.length > 0 && (
  <>
    <ol class="gt-pair" aria-label={body.label}>
      {body.rows.map((r) => (
        <li><span class="gt-pair__name">{r.name}</span><span class="gt-pair__bars"><span class="gt-pair__a" style={`width:${r.aw.toFixed(1)}%`}></span><span class="gt-pair__b" style={`width:${r.bw.toFixed(1)}%`}></span></span><span class="gt-pair__val tnum">{r.value}</span><span class="gt-pair__ch tnum">{r.change}</span></li>
      ))}
    </ol>
    <p class="gt-caption gt-pair__key"><span><i class="gt-pair__a"></i>{body.keyA}</span><span><i class="gt-pair__b"></i>{body.keyB}</span><span>{body.key}</span></p>
  </>
)}
{body.type === 'table' && (
  <div class="gt-tablewrap" style="--gt-table-h:none;border-top:0">
    <table class="gt-table gt-table--compact">
      <thead><tr>{body.cols.map((c) => <th scope="col" class:list={{ n: c.num }}><span>{c.text}</span></th>)}</tr></thead>
      <tbody>
        {body.rows.map((r) => (
          <tr>
            <th scope="row">{r.head}{r.sub && <small>{r.sub}</small>}</th>
            {r.cells.map((c) => (
              <td class:list={{ n: c.num, tnum: !c.num }}>{c.dir ? <span class="gt-chg"><svg viewBox="0 0 12 12" aria-hidden="true" set:html={c.dir === 'up' ? UP : c.dir === 'down' ? DOWN : FLAT} />{c.text}</span> : c.text}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
{body.notes.filter(Boolean).map((n) => <p class="gt-caption">{n}</p>)}
