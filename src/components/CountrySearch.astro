---
// Find a country: an ARIA combobox over a list of names (src/scripts/controls.ts). Picking one fires `gt-pick`
// with the option ({ name, note, value, href }) on the combobox; with href set it navigates.
import '../styles/atlas/filters.css';
import Icon from './Icon.astro';
import type { BlocNote } from '../lib/compare/model';

export interface CountryOption { name: string; value?: string; note?: string; href?: string }
interface Props {
  id: string;
  label: string;
  options: CountryOption[];
  placeholder?: string;
  /** Text when nothing matches; "{q}" is replaced by what was typed. */
  emptyText?: string;
  disabled?: boolean;
  /** The name already picked, shown in the box. */
  value?: string;
  /** Groupings: typed whole, the box shows the note, linking the grouping's page (Compare's boxes). */
  notes?: BlocNote[];
}
const { id, label, options, placeholder = 'Find a country', emptyText = 'No country called “{q}”. Try its English name.', disabled = false, value, notes } = Astro.props;
---
<div class="gt-field">
  <label for={`${id}-i`}>{label}</label>
  <div class:list={['gt-combo', { 'is-disabled': disabled }]} id={id} data-gt-combo data-options={JSON.stringify(options)} data-empty={emptyText} data-notes={notes?.length ? JSON.stringify(notes) : undefined}>
    <div class="gt-combo__box">
      <Icon name="search" />
      <input id={`${id}-i`} role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-l`} placeholder={placeholder} autocomplete="off" disabled={disabled} value={value} />
    </div>
    <ul class="gt-combo__list" role="listbox" id={`${id}-l`} hidden></ul>
  </div>
</div>

<script>
  import { initControls } from '../scripts/controls';
  initControls();
</script>
