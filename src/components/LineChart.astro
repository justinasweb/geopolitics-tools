---
// A line chart drawn at build time as SVG (svg.gt-lc, CountryCharts design). The markup comes from
// src/lib/linechart.ts, which browser scripts use too, so a chart drawn after the page loads (Compare) is the same.
import '../styles/atlas/country.css';
import '../styles/atlas/tools.css';
import { lineChartHtml, type LineChartProps } from '../lib/linechart';

export type { Line } from '../lib/linechart';
type Props = LineChartProps;
---
<Fragment set:html={lineChartHtml(Astro.props)} />
