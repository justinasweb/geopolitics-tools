---
// A population pyramid for one year, drawn at build time: men to the left, women to the right, five-year age
// groups from the bottom. Men solid, women outlined, and both named above their side, so colour is not the cue.
// The SVG has no viewBox: it is as wide as its column and its rows are fixed in pixels, so its text stays at the
// design sizes at any width. Each side's bars are a nested SVG stretched over half the width (0–100 units, the
// last GAP units left clear for the age labels in the middle); the text is placed in percent.
import '../styles/atlas/country.css';
import type { AgeGroup } from '../adapters/wpp';
import { DOSSIER_TEXT } from '../i18n/pages.en';

interface Props {
  label: string;
  groups: AgeGroup[];
  /** The widest bar's value, shared by every year of a pyramid with a year slider so the bars compare. */
  max?: number;
  hidden?: boolean;
  year?: number;
}
const { label, groups, hidden = false, year } = Astro.props;
const top = 24, row = 12, GAP = 10, side = 100 - GAP;
const rows = groups.length * row;
const H = top + rows + 24;
const max = Astro.props.max ?? (Math.max(...groups.flatMap((g) => [g.male, g.female])) || 1);
const w = (v: number) => (v / max) * side;
const y = (i: number) => (groups.length - 1 - i) * row;
// Where the bars start, in percent of the whole width.
const inner = (GAP / 100) * 50;
const millions = (v: number) => new Intl.NumberFormat('en', { maximumFractionDigits: 0 }).format(v / 1e6);
const exact = (v: number) => new Intl.NumberFormat('en', { maximumFractionDigits: v < 1e6 ? 2 : 1 }).format(v / 1e6);
const group = (g: AgeGroup) => g.group.replace('-', '–');
---
<svg height={H} style={`height:${H}px`} role="img" aria-label={label} data-year={year} {...(hidden ? { hidden: '' } as Record<string, string> : {})}>
  <text class="gt-pyr__h" x={`${50 - inner}%`} y={14} text-anchor="end">{DOSSIER_TEXT.men}</text>
  <text class="gt-pyr__h" x={`${50 + inner}%`} y={14}>{DOSSIER_TEXT.women}</text>
  <svg y={top} width="50%" height={rows} viewBox={`0 0 100 ${rows}`} preserveAspectRatio="none" aria-hidden="true">
    {groups.map((g, i) => <rect class="gt-pyr__m" x={side - w(g.male)} y={y(i)} width={w(g.male)} height={row - 2}><title>{DOSSIER_TEXT.pyramidBar(group(g), DOSSIER_TEXT.men, exact(g.male))}</title></rect>)}
  </svg>
  <svg x="50%" y={top} width="50%" height={rows} viewBox={`0 0 100 ${rows}`} preserveAspectRatio="none" aria-hidden="true">
    {groups.map((g, i) => <rect class="gt-pyr__f" x={GAP} y={y(i)} width={w(g.female)} height={row - 2}><title>{DOSSIER_TEXT.pyramidBar(group(g), DOSSIER_TEXT.women, exact(g.female))}</title></rect>)}
  </svg>
  {groups.map((g, i) => i % 2 === 0 && <text x="50%" y={top + y(i) + row - 2} text-anchor="middle">{g.start}</text>)}
  <text x="0" y={H - 6}>{millions(max)}m</text>
  <text x="50%" y={H - 6} text-anchor="middle">0</text>
  <text x="100%" y={H - 6} text-anchor="end">{millions(max)}m</text>
</svg>
