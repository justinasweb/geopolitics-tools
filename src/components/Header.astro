---
// Site header: logo, the top links (Countries, Indicators, This week), search, and the main menu grouped by the five
// topic hubs, then Tools. Under 760px of container width it becomes a compact bar; the menu button opens the phone
// menu as a panel under the bar, which stays in place. Behaviour: src/scripts/header.ts.
import '../styles/atlas/header.css';
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';
import PhoneMenu from './PhoneMenu.astro';
import { menu } from '../lib/menu';
import { NAV_TEXT, UI_TEXT } from '../i18n/en';

interface Props {
  /** The hub this page belongs to, or "tools", marked with aria-current on its menu button. */
  current?: string;
  /** Demo only (/dev/components): open one hub's panel, or "tools". */
  open?: string;
  /** Demo only (/dev/components): show the phone menu open in place, with this hub's group open. */
  menuOpen?: string;
  /** Prefix for element ids when a page shows more than one header (the components page). */
  idPrefix?: string;
  /** Show every hub, view and tool, built or not (the components page). */
  full?: boolean;
}
const { current, open, menuOpen, idPrefix = 'nav', full = false } = Astro.props;
const { hubs, top, tools } = menu(full);
const menuId = `${idPrefix}-menu`;
const demo = menuOpen !== undefined;
const groups = [
  ...hubs.map((hub) => ({ id: hub.id, name: NAV_TEXT.hubs[hub.id], links: hub.views.map((v) => ({ path: v.path, text: NAV_TEXT.views[v.id] })) })),
  ...(tools.length ? [{ id: 'tools', name: UI_TEXT.tools, links: tools.map((t) => ({ path: t.path, text: NAV_TEXT.tools[t.id] })) }] : []),
];
---
<header class="gt-header" data-gt-header>
  <div class="gt-header__in">
    <div class="gt-header__top">
      <a class="gt-logo" href="/" aria-label={UI_TEXT.home}><Lockup /></a>
      <div class="gt-header__util">
        {top.map((u) => <a href={u.path}>{NAV_TEXT.top[u.id]}</a>)}
        <button class="gt-searchbtn" type="button" data-gt-search>
          <Icon name="search" /><span class="gt-searchbtn__long">{UI_TEXT.searchPlaceholder}</span><span class="gt-searchbtn__short">{UI_TEXT.search}</span><kbd>/</kbd>
        </button>
      </div>
      <div class="gt-header__phone">
        <button class="gt-iconbtn" type="button" aria-label={UI_TEXT.search} data-gt-search><Icon name="search" /></button>
        <button class="gt-iconbtn gt-menubtn" type="button" aria-label={demo ? UI_TEXT.closeMenu : UI_TEXT.openMenu} aria-expanded={demo ? 'true' : 'false'}
          aria-controls={menuId} data-gt-menu-open data-open-label={UI_TEXT.openMenu} data-close-label={UI_TEXT.closeMenu}>
          <Icon name="menu" /><Icon name="close" />
        </button>
      </div>
    </div>
    {groups.length > 0 && <nav class="gt-nav" aria-label={UI_TEXT.mainNav}>
      {groups.map((g) => (
        <Fragment>
          {g.id === 'tools' && <span class="gt-nav__sep" aria-hidden="true" />}
          <div class:list={['gt-nav__item', { 'gt-nav__item--end': g.id === 'tools' }]}>
            <button
              class="gt-nav__btn"
              type="button"
              aria-expanded={open === g.id ? 'true' : 'false'}
              aria-controls={`${idPrefix}-${g.id}`}
              aria-current={current === g.id ? 'true' : undefined}
            >
              {g.name}<Icon name="chevron" />
            </button>
            <div class="gt-mega" id={`${idPrefix}-${g.id}`} hidden={open !== g.id}>
              <span class="gt-label">{g.name}</span>
              {g.links.map((l) => <a href={l.path}><strong>{l.text[0]}</strong><span>{l.text[1]}</span></a>)}
            </div>
          </div>
        </Fragment>
      ))}
    </nav>}
  </div>
</header>
<div class:list={['gt-menupanel', { 'gt-menupanel--demo': demo }]} id={menuId} role="region" aria-label={UI_TEXT.menu} tabindex="-1" hidden={!demo} data-gt-menu>
  <PhoneMenu idPrefix={idPrefix} full={full} open={menuOpen || undefined} />
</div>

<script>
  import { initHeader, bindSearchKey } from '../scripts/header';
  document.querySelectorAll<HTMLElement>('[data-gt-header]').forEach(initHeader);
  bindSearchKey();
</script>
