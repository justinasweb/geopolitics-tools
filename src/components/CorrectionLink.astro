---
// "Report a correction": in the footer only, not on source lines. Without JavaScript it is an email link to
// data@geopolitics.tools with the page in the subject; with it, src/scripts/correction.ts opens the correction form
// (CorrectionForm, in the Page layout) instead.
import '../styles/atlas/correction.css';
import { CORRECTION_TEXT, correctionMailto } from '../i18n/correction.en';

---
<a class="gt-corrlink" href={correctionMailto(Astro.url.pathname)} data-gt-corr><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 20h20z"/><path d="M12 10v4.5M12 17.2v.3"/></svg>{CORRECTION_TEXT.link}</a>

<script>
  import { initCorrection } from '../scripts/correction';
  initCorrection();
</script>
