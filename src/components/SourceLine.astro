---
// The line under every figure, chart and map: source, when the site last refreshed it, an optional status tag,
// and Copy citation, wired by src/scripts/copy.ts. Report a correction is in the footer only (CorrectionLink).
import '../styles/atlas/source.css';
import Icon from './Icon.astro';
import StatusTag, { type Status } from './StatusTag.astro';
import { SOURCE_TEXT } from '../i18n/en';
import SourceText from './SourceText.astro';
import { formatDate } from '../lib/format';

interface Props {
  /** The source's own name for itself, with edition: "USGS Mineral Commodity Summaries 2026". */
  source: string;
  /** When the site last refreshed the data (ISO date or Date). */
  updated?: string | Date;
  /** The words before that date where "Updated" would read as the source's own (IPC: "Last fetched"). */
  updatedLabel?: string;
  /** Extra plain parts, such as the period ("15–21 Oct 2026"). */
  parts?: string[];
  status?: Status;
  /** Full citation for Copy citation; no button when left out. */
  citation?: string;
  /** Show the button disabled (data still loading). */
  citeDisabled?: boolean;
  /** On a map view with a year control: each year's parts and status, in place of `parts` and `status`. `year`'s
   *  are shown; the map script shows another year's when the reader picks it (src/scripts/map/by-year.ts). */
  years?: { year: number; parts: string[]; status?: Status }[];
  year?: number;
}
const { source, updated, updatedLabel = SOURCE_TEXT.updated, parts = [], status, citation, citeDisabled = false, years, year } = Astro.props;
---
<p class="gt-source">
  <span>{SOURCE_TEXT.source} <b><SourceText text={source} /></b></span>
  {years
    ? years.map((e) => <span class="gt-source__yr" data-for-year={e.year} hidden={e.year !== year}>{e.parts.map((p) => <><span class="gt-source__sep" aria-hidden="true">·</span><span>{p}</span></>)}</span>)
    : parts.map((p) => <><span class="gt-source__sep" aria-hidden="true">·</span><span>{p}</span></>)}
  {updated && <><span class="gt-source__sep" aria-hidden="true">·</span><span>{updatedLabel} {formatDate(updated)}</span></>}
  {years
    ? years.filter((e) => e.status).map((e) => <span class="gt-source__yr" data-for-year={e.year} hidden={e.year !== year}><span class="gt-source__sep" aria-hidden="true">·</span><StatusTag status={e.status!} small /></span>)
    : status && <><span class="gt-source__sep" aria-hidden="true">·</span><StatusTag status={status} small /></>}
  {(citation || citeDisabled) && (
    <button class="gt-cite" type="button" data-gt-copy={citation} disabled={citeDisabled}><Icon name="copy" /><span data-label>{SOURCE_TEXT.cite}</span></button>
  )}
</p>

<script>
  import { initCopy } from '../scripts/copy';
  initCopy();
</script>
