---
// A site page: header, the page container, footer. The container is .gt-page (the 1200px measure), .gt-cp
// (country pages and Compare), .gt-tl (data tools and indicator pages) or .gt-mv (map views); each is the "page"
// container that phone layouts respond to.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoSprite from '../components/LogoSprite.astro';
import { data } from '../lib/data';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** The hub this page belongs to, or "tools", marked in the main menu. */
  hub?: string;
  /** Use a wider page container (map views, tools) instead of the 1200px measure. */
  wide?: boolean;
  container?: 'page' | 'cp' | 'tl' | 'mv';
  image?: string;
  jsonld?: object[];
  /** The page shows figures from the data snapshot (so a sample build marks it). */
  fromData?: boolean;
  /** An extra class on the container (gt-cp--thin). */
  mainClass?: string;
}
const { title, description, noindex = false, hub, wide = false, container = 'page', image, jsonld, fromData = true, mainClass } = Astro.props;
const cls = [...(container === 'page' ? ['gt-page', { 'gt-page--wide': wide }] : [`gt-${container}`]), mainClass];
---
<Base title={title} description={description} noindex={noindex} image={image} jsonld={jsonld} sample={fromData && data().sample}>
  <LogoSprite />
  <Header current={hub} />
  <main class:list={cls} id="top">
    <slot />
  </main>
  <Footer />
</Base>
