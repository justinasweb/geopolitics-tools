---
import { indexable, siteName } from '../lib/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteName ? title : `${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !indexable) && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      /* Placeholder styles until the design system arrives in phase 2 (colours from tokens.json). */
      :root {
        --paper: #f7f6f2;
        --ink: #1b2430;
        --ink-muted: #5b6470;
        --brand: #1f3550;
        --accent: #8f5d00;
        color-scheme: light;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 17px/27px 'Source Sans 3', 'Segoe UI', system-ui, sans-serif;
      }
      main {
        max-width: 68ch;
        margin: 0 auto;
        padding: 64px 16px;
      }
      h1 {
        font: 600 44px/50px Newsreader, Georgia, 'Times New Roman', serif;
        letter-spacing: -0.015em;
        margin: 0 0 16px;
      }
      @media (max-width: 759px) {
        h1 { font-size: 32px; line-height: 38px; }
      }
      a { color: var(--brand); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .muted { color: var(--ink-muted); }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
