---
// The document shell: head (title, description, canonical, robots, share card, structured data), design tokens,
// self-hosted fonts and the .gt wrapper every Atlas component expects. The canonical is the path without any query
// string, so view states never compete with the page they belong to.
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/atlas/base.css';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import StatusTag from '../components/StatusTag.astro';
import { indexable, siteName } from '../lib/site';
import { organization } from '../lib/structured';
import { SAMPLE_BANNER } from '../i18n/pages.en';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Share image path (1200 × 630). */
  image?: string;
  /** Structured data for this page (JSON-LD objects), besides the site-wide Organization. */
  jsonld?: object[];
  /** Pages built from data show the sample banner in a sample build. */
  sample?: boolean;
  lang?: string;
}
const { title, description, noindex = false, image = '/og/page/default.png', jsonld = [], sample = false, lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const imageUrl = new URL(image, Astro.site).href;
const ld = [organization(), ...jsonld];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {(noindex || !indexable) && <meta name="robots" content={noindex ? 'noindex, follow' : 'noindex'} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
  </head>
  <body class="gt">
    {sample && (
      <p class="gt-samplebar" role="note"><StatusTag status="sample" small /> {SAMPLE_BANNER}</p>
    )}
    <slot />
    <p id="gt-live" class="gt-vh" aria-live="polite"></p>
  </body>
</html>

<style is:global>
  .gt-samplebar { margin: 0; padding: 8px 16px; background: var(--est-bg); color: var(--ink); font: 400 14px/20px var(--sans); text-align: center; border-bottom: 1px solid var(--rule-strong); }
</style>
