---
// The Atlas (Atlas and AtlasPhone designs): one full-screen map with every shaded layer of every live map view. A slim
// bar with Share, the layer list (topics, then one row per map view family, a select where a family has several
// layers, then the topic's overlays), the map with its legend box and year card, and the panel (the world, or the
// selected country). Under 760px the map fills the screen: the list opens as a sheet from the Layers button, the
// panel as a second sheet when a country is tapped, and the legend folds to one line. The list, the legend and the
// world panel for the opening layer are HTML, so the page reads before the script; the script (src/scripts/atlas.ts)
// draws the map with the map engine and keeps ?layer=&year=&country=&overlays= in the address. The layers are the map
// views' own layer files (src/lib/atlas.ts): no data of its own.
import Base from '../layouts/Base.astro';
import LogoSprite from '../components/LogoSprite.astro';
import Lockup from '../components/Lockup.astro';
import Icon from '../components/Icon.astro';
import '../styles/atlas/mapview.css';
import '../styles/atlas/panel.css';
import '../styles/atlas/country.css';
import '../styles/atlas/bars.css';
import '../styles/atlas/tooltip.css';
import '../styles/atlas/tags.css';
import '../styles/atlas/filters.css';
import '../styles/atlas/legend.css';
import '../styles/atlas/years.css';
import '../styles/atlas/states.css';
import '../styles/atlas/share.css';
import '../styles/atlas/source.css';
import '../styles/atlas/notice.css';
import '../styles/atlas/atlasmap.css';
import { ATLAS_TEXT as A } from '../i18n/atlas.en';
import { MAP_TEXT } from '../i18n/map.en';
import { NAV_TEXT, SOURCE_TEXT, UI_TEXT } from '../i18n/en';
import { atlasLayers, atlasOverlays, atlasTopics, defaultLayer } from '../lib/atlas';
import { layerFile } from '../lib/map/layers';
import { legendHtml, markSvg } from '../scripts/map/legend';
import { worldPanelHtml } from '../scripts/map/panel';
import { live, paths } from '../lib/routes';
import { PLACES } from '../lib/places';
import { breadcrumbs } from '../lib/structured';

const topics = atlasTopics();
const layers = atlasLayers();
const overlays = atlasOverlays();
const first = defaultLayer();
const firstFile = layerFile(first.id);
const firstIndex = firstFile.years.indexOf(first.year);
const rows = topics.reduce((n, t) => n + t.rows.length, 0);
const rowLabel = new Map(topics.flatMap((t) => t.rows.map((r) => [r.family, r.label])));
// The bar's links: pages that are live.
const nav = (['countries', 'tool:explorer'] as const).flatMap((k) => {
  const r = live(k);
  return r ? [{ href: r.path, label: k === 'countries' ? NAV_TEXT.top.countries : NAV_TEXT.tools.explorer[0] }] : [];
});
// What a row says under its name: the layer's name when the family has several, else what it measures.
const sub = (n: number, l: (typeof layers)[number]) => (n > 1 ? l.name : l.measure);
const src = (l: (typeof layers)[number]) => `${l.source} · ${l.span}`;
const title = (l: (typeof layers)[number]) => A.current(rowLabel.get(l.family)!, l.name);
const ramp = (scale: 'seq' | 'div') => Array.from({ length: scale === 'seq' ? 5 : 7 }, (_, i) => `<i style="background:var(--${scale}-${i + 1})"></i>`).join('');

// Words the script fills in: {placeholders}, as in the layer files.
const words = {
  found: A.found, on: A.on(0).replace('0', '{n}'), hide: A.hide, show: A.show, showLegend: A.phone.showLegend,
  remove: A.removeOverlay('{name}'), drawnFor: A.drawnFor, withCountry: A.withCountry('{layer}', '{country}'),
  loading: A.loading('{layer}'), loadingNote: A.loadingNote('{country}'), loadingNoteNone: A.loadingNote(null),
  pickHint: A.pickHint, top: A.top('{year}'), seeFull: A.seeFull('{layer}'), previous: A.previous,
  greyMeans: A.greyMeans('{none}'), otherLayers: A.otherLayers('{country}'),
  year: { ...A.year, latest: A.year.latest('{got}', '{want}'), earliest: A.year.earliest('{got}', '{want}'), nearest: A.year.nearest('{got}', '{want}') },
  shareText: A.description(layers.length),
};
const manifest = {
  start: first.key,
  slugs: Object.fromEntries(PLACES.map((p) => [p.id, p.slug])),
  overlays: overlays.map((o) => ({ id: o.id, label: o.label, variants: o.variants })),
  topics: topics.map((t) => ({ id: t.id, label: t.label, rows: t.rows.map((r) => ({ family: r.family, label: r.label, layers: r.layers.map((l) => l.key) })) })),
  layers: layers.map((l) => ({ key: l.key, id: l.id, file: l.file, family: l.family, name: l.name, years: l.years, year: l.year, axis: l.axis, path: l.path, title: title(l) })),
  words,
};
const json = JSON.stringify(manifest).replace(/</g, '\\u003c');
const crumbs = [{ label: A.crumb }, { label: A.title }];
const pageUrl = new URL(paths.atlas(), Astro.site).href;
const shareQ = (u: string) => `url=${encodeURIComponent(u)}&text=${encodeURIComponent(words.shareText)}`;
const multi = overlays.filter((o) => o.variants.length > 1);
---
<Base title={A.title} description={A.description(layers.length)} image={paths.image('tools', 'atlas')} jsonld={[breadcrumbs(crumbs)]}>
  <LogoSprite />
  <div class="gt-atlas" data-atlas data-basemap="/geo/basemap.json">
    <header class="gt-atbar">
      <a class="gt-atbar__back gt-iconbtn" href="/" aria-label={A.phone.back}><Icon name="chevron" /></a>
      <a class="gt-logo" href="/" aria-label={UI_TEXT.home}><Lockup /></a>
      <span class="gt-atbar__div" aria-hidden="true"></span>
      <h1 class="gt-atbar__t">{A.title}<span data-at-current>{title(first)}</span></h1>
      {nav.length > 0 && <nav class="gt-atbar__nav" aria-label={A.nav}>{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>}
      <button class="gt-btn gt-btn--quiet gt-btn--sm gt-atbar__share" type="button" aria-expanded="false" aria-controls="at-share" data-at-share>
        <Icon name="link" /><span>{A.share.button}</span>
      </button>
      <section class="gt-atshare" id="at-share" aria-labelledby="at-share-t" hidden>
        <div class="gt-atshare__head">
          <h2 class="gt-label" id="at-share-t">{A.share.title}</h2>
          <button class="gt-iconbtn" type="button" aria-label={A.share.close} data-at-shareclose><Icon name="close" /></button>
        </div>
        <div class="gt-aturl">
          <code data-at-url>{pageUrl}</code>
          <button class="gt-btn gt-btn--sm" type="button" data-gt-copy={pageUrl}><span data-label>{A.share.copy}</span></button>
        </div>
        <p class="gt-caption">{A.share.note}</p>
        <div class="gt-atshare__icons">
          <span class="gt-caption">{A.share.on}</span>
          <a class="gt-share__icon" data-at-sharex href={`https://x.com/intent/post?${shareQ(pageUrl)}`} aria-label={SOURCE_TEXT.shareOn('X')} title={SOURCE_TEXT.shareOn('X')}><Icon name="x" /></a>
          <a class="gt-share__icon" data-at-sharetg href={`https://t.me/share/url?${shareQ(pageUrl)}`} aria-label={SOURCE_TEXT.shareOn('Telegram')} title={SOURCE_TEXT.shareOn('Telegram')}><Icon name="telegram" /></a>
        </div>
      </section>
    </header>
    <div class="gt-atbody">
      <aside class="gt-atlayers" id="at-layers" aria-labelledby="at-layers-t">
        <div class="gt-atsheet__head">
          <h2 class="gt-h3" id="at-layers-t">{A.layers}</h2>
          <button class="gt-iconbtn" type="button" aria-label={A.phone.close} data-at-layersclose><Icon name="close" /></button>
        </div>
        <div class="gt-atlayers__top">
          <p class="gt-label" aria-hidden="true">{A.layers}</p>
          <div class="gt-atsearch">
            <Icon name="search" />
            <label class="gt-vh" for="at-search">{A.search}</label>
            <input id="at-search" type="search" autocomplete="off" placeholder={A.searchPlaceholder} data-at-search />
            <button class="gt-iconbtn" type="button" aria-label={A.clearSearch} hidden data-at-clear><Icon name="close" /></button>
          </div>
          <p class="gt-caption" aria-live="polite" data-at-found>{A.oneLayer}</p>
        </div>
        <div class="gt-athint" role="note" hidden data-at-hint>
          <b>{A.hint.title}</b>
          <p>{A.hint.body(rows, topics.length)}</p>
          <button class="gt-btn gt-btn--quiet gt-btn--sm" type="button" data-at-hintok>{A.hint.ok}</button>
        </div>
        <div class="gt-atlayers__list">
          {/* Phone: overlays first, one at a time (AtlasPhone design). */}
          {overlays.length > 0 && (
            <fieldset class="gt-atov">
              <legend class="gt-label">{A.phone.overlay}</legend>
              <div class="gt-atov__opts">
                <label class="gt-atov__o"><input type="radio" name="at-ovp" value="" checked /><span>{A.phone.none}</span></label>
                {overlays.map((o) => <label class="gt-atov__o"><input type="radio" name="at-ovp" value={o.id} /><span><Fragment set:html={markSvg(o.glyph)} />{o.label}</span></label>)}
              </div>
              {multi.map((o) => (
                <div class="gt-atov__sub" hidden data-at-ovp-sub={o.id}>
                  <label class="gt-field__label" for={`at-op-${o.id}`}>{A.overlay[o.id as 'flows' | 'bloc'].pick}</label>
                  <div class="gt-select gt-select--sm">
                    <select id={`at-op-${o.id}`} data-at-ovp-variant={o.id}>{o.variants.map((x) => <option value={x.token}>{x.label}</option>)}</select>
                  </div>
                </div>
              ))}
              <p class="gt-label gt-atov__shaded">{A.phone.shaded}</p>
            </fieldset>
          )}
          {topics.map((t) => {
            const on = t.rows.some((r) => r.family === first.family);
            const ovs = overlays.filter((o) => o.topic === t.id);
            return (
              <details class="gt-lgroup" open={on} data-at-topic={t.id}>
                <summary><span>{t.label}</span><small>{A.count(t.rows.length, ovs.length)}</small><span class="gt-lgroup__on" hidden={!on} data-at-on>{A.on(1)}</span></summary>
                <ul class="gt-lyrs" aria-label={t.label}>
                  {t.rows.map((r) => {
                    const cur = r.family === first.family ? first : r.layers[0];
                    const many = r.layers.length > 1;
                    return (
                      <li class:list={['gt-lyr', { 'is-on': cur === first }]} data-at-row={r.family} data-at-key={cur.key}
                        data-at-words={[r.label, t.label, ...r.layers.map((l) => l.name)].join('|').toLowerCase()}>
                        <label class="gt-lyr__l">
                          <input type="radio" name="at-layer" value={r.family} checked={cur === first} />
                          <span class="gt-lyr__t">
                            <b>{r.label}</b>
                            <small data-at-sub>{sub(r.layers.length, cur)}</small>
                            <small class="gt-lyr__src" data-at-src>{src(cur)}</small>
                          </span>
                        </label>
                        {many && (
                          <div class="gt-lyr__sub" hidden={cur !== first}>
                            <label class="gt-vh" for={`at-v-${r.family}`}>{`${r.label}: ${A.variant}`}</label>
                            <div class="gt-select gt-select--sm">
                              <select id={`at-v-${r.family}`} data-at-variant>
                                {r.layers.map((l) => <option value={l.key} selected={l === cur} data-sub={sub(r.layers.length, l)} data-src={src(l)}>{l.name}</option>)}
                              </select>
                            </div>
                          </div>
                        )}
                      </li>
                    );
                  })}
                </ul>
                {ovs.length > 0 && <p class="gt-lgroup__ov" id={`at-ov-${t.id}`}>{A.overlays}</p>}
                {ovs.length > 0 && (
                  <ul class="gt-lyrs gt-lyrs--ov" aria-labelledby={`at-ov-${t.id}`}>
                    {ovs.map((o) => {
                      const v = o.variants[0];
                      const many = o.variants.length > 1;
                      const osub = (x: typeof v) => (many ? x.label : o.desc);
                      return (
                        <li class="gt-lyr gt-lyr--ov" data-at-ov={o.id} data-at-tok={v.token}
                          data-at-words={[o.label, o.desc, t.label, ...o.variants.map((x) => x.label)].join('|').toLowerCase()}>
                          <label class="gt-lyr__l">
                            <input type="checkbox" value={o.id} />
                            <span class="gt-lyr__t">
                              <b><Fragment set:html={markSvg(o.glyph)} />{o.label}</b>
                              <small data-at-sub>{osub(v)}</small>
                              {v.source && <small class="gt-lyr__src" data-at-src>{v.source}</small>}
                            </span>
                          </label>
                          {many && (
                            <div class="gt-lyr__sub" hidden>
                              <label class="gt-vh" for={`at-o-${o.id}`}>{`${o.label}: ${A.overlay[o.id as 'flows' | 'bloc'].pick}`}</label>
                              <div class="gt-select gt-select--sm">
                                <select id={`at-o-${o.id}`} data-at-ovvariant>
                                  {o.variants.map((x) => <option value={x.token} data-sub={osub(x)} data-src={x.source ?? ''}>{x.label}</option>)}
                                </select>
                              </div>
                            </div>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                )}
              </details>
            );
          })}
        </div>
      </aside>
      <div class="gt-atmap">
        <div class="gt-maphost">
          <div class="gt-mapcanvas" aria-label={A.title} aria-describedby="at-keys"></div>
          <p class="gt-vh" id="at-keys">{MAP_TEXT.keys}</p>
          <div class="gt-mapstate" data-map-state="loading"><p class="gt-mapstate__msg">{MAP_TEXT.loading}</p></div>
          <div class="gt-mapstate" data-map-state="error" hidden>
            <div class="gt-mapstate__err" role="alert">
              <p class="gt-mapstate__msg"><Icon name="alert" />{MAP_TEXT.failed}</p>
              <p><button class="gt-btn gt-btn--quiet" type="button" data-map-retry>{MAP_TEXT.retry}</button></p>
            </div>
          </div>
          <div class="gt-atloadcard" role="status" hidden data-at-loading>
            <p class="gt-atloadcard__t"><span class="gt-atspin" aria-hidden="true"></span><b data-at-loading-t></b></p>
            <p class="gt-caption" data-at-loading-n></p>
          </div>
          <div class="gt-zoom" role="group" aria-label={MAP_TEXT.zoom}>
            <button type="button" aria-label={MAP_TEXT.zoomIn} data-zoom="in">+</button>
            <button type="button" aria-label={MAP_TEXT.zoomOut} data-zoom="out">−</button>
            <button type="button" aria-label={MAP_TEXT.reset} data-zoom="reset"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.5-3.5M3 2.5V5h2.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
          </div>
          <section class="gt-atleg" aria-labelledby="at-leg-t" data-at-legend>
            <div class="gt-atleg__bar">
              <h2 class="gt-label" id="at-leg-t">{A.legend}</h2>
              <button class="gt-linkbtn" type="button" aria-expanded="true" aria-controls="at-leg-body" data-at-leghide>{A.hide}</button>
            </div>
            {/* Phone: one line (ramp, layer, Show legend) that unfolds the box. */}
            <button class="gt-atlegm__b" type="button" aria-expanded="false" aria-controls="at-leg-body" data-at-leghide>
              <span class="gt-atlegm__ramp" aria-hidden="true" data-at-ramp set:html={ramp(firstFile.scale)} />
              <span class="gt-atlegm__t" data-at-legname>{firstFile.data[firstIndex].legend}</span>
              <span class="gt-atlegm__a" data-at-legact>{A.phone.showLegend}</span>
            </button>
            <div class="gt-atleg__body" id="at-leg-body">
              <div class="gt-atleg__s"><div class="gt-legend gt-mapleg" data-at-shaded set:html={legendHtml(firstFile, firstIndex)} /></div>
              <div data-at-ovlegs></div>
            </div>
          </section>
          <div class="gt-atyear" hidden data-at-year></div>
          <p class="gt-atborders"><i aria-hidden="true"></i>{MAP_TEXT.borders} <a href={paths.page('methodology')}>{MAP_TEXT.howBorders}</a></p>
          <div class="gt-athint gt-athint--phone" role="note" hidden data-at-hint>
            <b>{A.hint.title}</b>
            <p>{A.hint.phone(rows, topics.length)}</p>
            <button class="gt-btn gt-btn--quiet gt-btn--sm" type="button" data-at-hintok>{A.hint.ok}</button>
          </div>
          <div class="gt-atdock">
            <button class="gt-btn gt-atdock__l" type="button" aria-expanded="false" aria-controls="at-layers" data-at-layersopen>
              <svg class="gt-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 3 9l9 5 9-5z" /><path d="m3 14 9 5 9-5" /></svg>{A.phone.layers}<span data-at-dock>{first.name}</span>
            </button>
          </div>
          <div class="gt-tip gt-world__tip" hidden aria-hidden="true"></div>
        </div>
      </div>
      <aside class="gt-panel gt-mvpanel gt-atpanel" aria-label={MAP_TEXT.panel} data-at-panel
        set:html={worldPanelHtml(firstFile, firstIndex, { hint: A.pickHint, top: A.top('{year}'), first: { href: first.path, label: A.seeFull(first.name) } })} />
    </div>
  </div>
  <script type="application/json" id="at-data" set:html={json} />
</Base>

<script>
  import { initAtlas } from '../scripts/atlas';
  const root = document.querySelector<HTMLElement>('[data-atlas]');
  if (root) initAtlas(root);
</script>
