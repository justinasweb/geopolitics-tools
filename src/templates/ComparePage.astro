---
// A static Compare pair (ComparePage design): /compare/united-states-vs-china and the other two, indexed, with share
// images. Its sections come from the same model and markup as /compare in the browser (src/lib/compare/), so the
// two cannot drift: key figures both countries have, side by side with "Higher" on the larger value and what could
// not be compared under them; both countries over time on one scale; shares of world mine production in pairs.
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareRow from '../components/ShareRow.astro';
import ComparePicker from '../components/ComparePicker.astro';
import '../styles/atlas/country.css';
import '../styles/atlas/table.css';
import '../styles/atlas/source.css';
import '../styles/atlas/tags.css';
import '../styles/atlas/correction.css';
import { COMPARE_TEXT as T, COUNTRY_TEXT, inSentence } from '../i18n/pages.en';
import { compareData, compareMeta } from '../lib/compare';
import { compareHtml, keyChipsHtml } from '../lib/compare/render';
import { paths, routes } from '../lib/routes';
import { breadcrumbs } from '../lib/structured';

interface Props { a: string; b: string }
const { a, b } = Astro.props;
const meta = compareMeta();
const c: [ReturnType<typeof compareData>, ReturnType<typeof compareData>] = [compareData(a), compareData(b)];
const [na, nb] = c.map((x) => x.name);
const title = T.title(na, nb);
const path = paths.compare(a, b);
const url = new URL(path, Astro.site).href;
const others = routes().filter((r) => r.kind === 'compare' && r.live && r.id && r.path !== path).map((r) => ({ href: r.path, label: meta.pairs.find((p) => p.path === r.path)!.title }));
const crumbs = [{ label: COUNTRY_TEXT.countries, href: paths.countries() }, { label: T.kicker, href: paths.compareAny() }, { label: `${na} and ${nb}` }];
---
<Page title={title} description={T.description(na, nb)} container="cp" mainClass="gt-cmp" image={paths.image('compare', path.split('/').at(-1)!)} jsonld={[breadcrumbs(crumbs)]}>
  <header class="gt-cmphead">
    <Breadcrumbs items={crumbs} />
    <h1 class="gt-title gt-cphead__t">{inSentence(na, true)} and {inSentence(nb)}</h1>
    <p class="gt-lede">{T.lede(inSentence(na, true), inSentence(nb))}</p>
    <div class="gt-ckey" set:html={keyChipsHtml(c)} />
    <ShareRow url={url} text={title} />
  </header>

  <Fragment set:html={compareHtml(meta, c)} />

  <section class="gt-cpsec" aria-labelledby="others-h">
    <header class="gt-cpsec__head"><h2 class="gt-h2" id="others-h">{T.others}</h2></header>
    <ComparePicker id="cmp-other" a={c[0].slug} b={c[1].slug} />
    {others.length > 0 && <ul class="gt-cplinks">{others.map((o) => <li><a href={o.href}>{o.label} <span aria-hidden="true">→</span></a></li>)}</ul>}
  </section>
</Page>
