---
// An alliance history view (/blocs/{bloc}/history): the grouping's members year by year from its founding. The slider
// (with play) steps through the years; the map shades who joined that year, who was a member, who left and who had
// left before; the panel gives the year's changes and notes. Below: the timeline of every change and every country
// that has been a member.
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SourceLine from '../components/SourceLine.astro';
import Notice from '../components/Notice.astro';
import ShareRow from '../components/ShareRow.astro';
import MapStage from '../components/MapStage.astro';
import MapControls from '../components/MapControls.astro';
import '../styles/atlas/mapview.css';
import '../styles/atlas/bars.css';
import '../styles/atlas/keyfigure.css';
import '../styles/atlas/table.css';
import '../styles/atlas/tools.css';
import { MAP_TEXT, BLOC_TEXT } from '../i18n/map.en';
import { BLOCS_TEXT, HISTORY_EVENTS, HISTORY_TEXT as H } from '../i18n/blocs.en';
import { list } from '../i18n/pages.en';
import { BLOCS_CHECKED } from '../lib/blocs';
import { HISTORY_BLOCS, historyPage, spanText } from '../lib/history';
import { formatDate } from '../lib/format';
import { place } from '../lib/places';
import { countryHref, live, route, hubCrumb } from '../lib/routes';
import { layerFile, layerPath } from '../lib/map/layers';
import { breadcrumbs } from '../lib/structured';

interface Props { id: string }
const { id } = Astro.props;
const p = historyPage(id)!;
const key = (b: string) => `view:alliance-history:${b}`;
const path = route(key(id))!.path;
const url = new URL(path, Astro.site).href;
const name = BLOC_TEXT[id] ?? id;
const title = H.title(name);
const nameOf = (x: string) => place(x)?.name ?? x;
const first = p.years[0];
const last = p.years.at(-1)!;
const events = HISTORY_EVENTS[id] ?? {};
const answer = H.lede(name, first, p.byYear[first].members.length, p.byYear[last].members.length, last, p.changes.length);
const crumbs: { label: string; href?: string }[] = [hubCrumb('power'), { label: BLOCS_TEXT.section, href: route('view:blocs:all')!.path }, ...(live(`view:blocs:${id}`) ? [{ label: name, href: live(`view:blocs:${id}`)!.path }] : []), { label: H.section }];
const picker = HISTORY_BLOCS.filter((b) => live(key(b))).map((b) => ({ label: BLOC_TEXT[b] ?? b, href: live(key(b))!.path, current: b === id }));
const timelineYears = [...new Set([...p.changes, ...Object.keys(events).map(Number)])].filter((y) => y >= first && y <= last).sort((a, b) => a - b);
const names = (ids: string[]) => list(ids.map(nameOf));
const source = `${H.source}, ${formatDate(BLOCS_CHECKED)}`;
const related = [
  ...(live(`view:blocs:${id}`) ? [{ href: live(`view:blocs:${id}`)!.path, name, note: H.today }] : []),
  ...picker.filter((o) => !o.current).slice(0, 3).map((o) => ({ href: o.href, name: o.label, note: H.history })),
];
---
<Page title={title} description={H.description(name, first)} hub="power" container="mv" image={route(key(id))!.image}
  jsonld={[breadcrumbs(crumbs.map((c) => ({ label: c.label, href: c.href })))]}>
  <div class="gt-mvhead">
    <Breadcrumbs items={crumbs} />
    <h1 class="gt-title gt-mvhead__t">{title} <span class="gt-mvhead__sub">{H.sub(first, last)}</span></h1>
    <p class="gt-lede gt-mvhead__a">{answer}</p>
    <SourceLine source={source} parts={[H.sub(first, last)]} />
  </div>

  <MapControls pickerLabel={H.pickerLabel} picker={picker} pickerSelect years={p.years} year={last} />

  <MapStage layer={layerPath(`history-${id}`)} label={H.mapLabel(name, last, p.byYear[last].members.length)} title={title}
    legend={{ title: H.legend(last), scale: 'seq', ticks: [], none: H.notMember, categories: layerFile(`history-${id}`).categories }}>
    <div data-panel="world" slot="panel">
      <div class="gt-panel__head">
        <div class="gt-panel__title"><span class="gt-kicker">{name} · <span data-year-text>{last}</span></span><h2 class="gt-h3">{MAP_TEXT.world}</h2></div>
      </div>
      <div class="gt-panel__body">
        {p.years.map((yr) => {
          const Y = p.byYear[yr];
          const prev = p.byYear[yr - 1];
          return (
            <div class="gt-pyear" data-year={yr} hidden={yr !== last}>
              <div class="gt-pkf">
                <span class="gt-pkf__label">{H.members}</span>
                <span class="gt-pkf__num">{Y.members.length}</span>
                {prev && prev.members.length !== Y.members.length && <span class="gt-pkf__meta">{yr - 1}: {prev.members.length}</span>}
              </div>
              <div class="gt-pblock">
                <div class="gt-pblock__head"><span class="gt-label">{H.changesIn(yr)}</span></div>
                {Y.joined.length === 0 && Y.left.length === 0 && !events[yr] && <p class="gt-caption">{H.noChange}</p>}
                <ul class="gt-prows">
                  {Y.joined.length > 0 && <li><span class="gt-prow__n">{H.joined}</span><span class="gt-prow__v">{names(Y.joined)}</span></li>}
                  {Y.left.length > 0 && <li><span class="gt-prow__n">{H.left}</span><span class="gt-prow__v">{names(Y.left)}</span></li>}
                </ul>
                {events[yr] && <p class="gt-caption gt-pblock__cap">{events[yr]}</p>}
              </div>
            </div>
          );
        })}
        <div class="gt-blocline" hidden><span class="gt-blocline__key" aria-hidden="true"></span><p></p></div>
        <Notice>
          <p>{H.caveat}</p>
          <SourceLine source={source} parts={[H.sub(first, last)]} />
        </Notice>
      </div>
    </div>
  </MapStage>

  <section class="gt-mvbelow" aria-labelledby="mv-sum">
    <div class="gt-mvbelow__main">
      <h2 class="gt-h2" id="mv-sum">{H.timeline}</h2>
      <div class="gt-tablewrap" style="--gt-table-h:none" tabindex="0" role="region" aria-label={H.timeline}>
        <table class="gt-table" data-gt-sort>
          <caption class="gt-caption">{H.timelineCaption(name)}</caption>
          <thead><tr>
            <th scope="col" class="n" data-key="y" data-type="num" aria-sort="ascending"><button type="button">{H.year}</button></th>
            <th scope="col" data-key="j"><button type="button">{H.joined}</button></th>
            <th scope="col" data-key="l"><button type="button">{H.left}</button></th>
            <th scope="col" class="n" data-key="c" data-type="num"><button type="button">{H.count}</button></th>
            <th scope="col" data-key="t" style="min-width:240px"><button type="button">{H.note}</button></th>
          </tr></thead>
          <tbody>
            {timelineYears.map((y) => (
              <tr>
                <th scope="row" class="n" data-v={y}>{y}</th>
                <td>{p.byYear[y].joined.length ? names(p.byYear[y].joined) : '–'}</td>
                <td>{p.byYear[y].left.length ? names(p.byYear[y].left) : '–'}</td>
                <td class="n" data-v={p.byYear[y].members.length}>{p.byYear[y].members.length}</td>
                <td>{events[y] ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <SourceLine source={source} parts={[H.sub(first, last)]} />
      <h2 class="gt-h2" id="table">{H.everTable}</h2>
      <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={H.everTable}>
        <table class="gt-table" data-gt-sort>
          <caption class="gt-caption">{H.everCaption} {H.caveat}</caption>
          <thead><tr>
            <th scope="col" data-key="n"><button type="button">{H.country}</button></th>
            <th scope="col" class="n" data-key="j" data-type="num" aria-sort="ascending"><button type="button">{H.joined}</button></th>
            <th scope="col" data-key="s"><button type="button">{H.spans}</button></th>
          </tr></thead>
          <tbody>
            {p.ever.map((x) => (
              <tr data-place={x}>
                <th scope="row">{countryHref(x) ? <a href={countryHref(x)}>{nameOf(x)}</a> : nameOf(x)}</th>
                <td class="n" data-v={Math.min(...p.spans.filter((s) => s.place === x).map((s) => s.from))}>{Math.min(...p.spans.filter((s) => s.place === x).map((s) => s.from))}</td>
                <td>{spanText(p.spans, x)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <aside class="gt-mvbelow__side">
      <h2 class="gt-label">{BLOCS_TEXT.related}</h2>
      <ul class="gt-related">{related.map((r) => <li><a href={r.href}><span>{r.name}</span><small>{r.note}</small></a></li>)}</ul>
      <div class="gt-mvbelow__share"><ShareRow url={url} text={answer} /></div>
    </aside>
  </section>
</Page>

<script>
  import { initSortable } from '../scripts/table';
  document.querySelectorAll<HTMLTableElement>('table[data-gt-sort]').forEach(initSortable);
</script>
