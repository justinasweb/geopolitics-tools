---
// One supply chain (SupplyChainPage and SankeyFlow designs): suppliers to buyers for one flow, for the latest year
// its source reports, as a Sankey with a side panel, and the same flows as a table. The build draws the page with no
// country focused, so it reads without scripts; the browser script (src/scripts/supply-chains.ts) then focuses a
// country, keeping it in the address. On a phone the top ten flows come first and the diagram opens on request.
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SourceLine from '../components/SourceLine.astro';
import '../styles/atlas/tools.css';
import '../styles/atlas/table.css';
import '../styles/atlas/filters.css';
import '../styles/atlas/country.css';
import '../styles/atlas/bars.css';
import '../styles/atlas/mapview.css';
import '../styles/atlas/source.css';
import '../styles/atlas/explorer.css';
import '../styles/atlas/supply-chains.css';
import { CHAINS_TEXT as T, SIDES, chainTitle } from '../i18n/supply-chains.en';
import { chainLinks, chainOf } from '../lib/supply-chains';
import { controlsHtml, flowListHtml, ledeOf, panelHtml, periodLabel, sankeyHtml, tableHtml } from '../lib/supply-chains/render';
import { CHAIN_SLUGS } from '../i18n/slugs.en';
import { paths } from '../lib/routes';
import { breadcrumbs } from '../lib/structured';

interface Props { flow: string }
const { flow } = Astro.props;
const chain = chainOf(flow);
const state = { country: '' };
const head = chainTitle(flow, chain.label);
const sides = SIDES[chain.kind];
const crumbs = [{ label: T.crumb }, { label: T.title, href: paths.supplyChains() }, { label: head.title }];
const json = JSON.stringify({ chain }).replace(/</g, '\\u003c');
---
<Page title={head.full} description={T.description(head.full, chain.period, sides.froms, sides.tos, chain.credit)} hub="tools" container="tl" mainClass="gt-skpage"
  image={paths.image('tools', `supply-chains-${CHAIN_SLUGS[flow] ?? flow}`)} jsonld={[breadcrumbs(crumbs)]}>
  <header class="gt-tlhead">
    <Breadcrumbs items={crumbs} />
    <h1 class="gt-title gt-tlhead__t">{head.title} <span class="gt-mvhead__sub">{head.sub}</span></h1>
    <p class="gt-lede gt-tlhead__a">{ledeOf(chain)}</p>
    <SourceLine source={chain.source} parts={[periodLabel(chain)]} updated={chain.updated} />
  </header>
  <div class="gt-expctl gt-skctl" data-sk-ctl set:html={controlsHtml(chain, state, chainLinks())} />
  <section class="gt-tlsec gt-skphone" data-sk-phone>
    <div class="gt-skphone__l" data-sk-list set:html={flowListHtml(chain, state)} />
    <button class="gt-btn gt-btn--quiet gt-showall" type="button" aria-expanded="false" aria-controls="sk-stage" data-sk-open>{T.showDiagram}</button>
  </section>
  <div class="gt-skstage" id="sk-stage">
    <div class="gt-skstage__d" data-sk-d set:html={sankeyHtml(chain, state)} />
    <aside class="gt-mpanel gt-skpanel" data-sk-panel set:html={panelHtml(chain, state)} />
  </div>
  <section class="gt-tlsec">
    <h2 class="gt-h2">{T.tableTitle}</h2>
    <div class="gt-sktable" data-sk-table set:html={tableHtml(chain, state)} />
  </section>
  <script type="application/json" id="sk-chain" set:html={json} />
</Page>

<script>
  import { initSupplyChain } from '../scripts/supply-chains';
  initSupplyChain();
</script>
