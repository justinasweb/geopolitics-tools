---
// Bloc overlap (BlocOverlap and BlocOverlapPage designs): the chosen blocs' shared members, the bridge countries and
// every country's memberships. The build draws the default settings, so the page reads without scripts; the browser
// script (src/scripts/overlap.ts) then redraws as the reader chooses blocs, keeping the settings in the address. On a
// phone the matrix gives way to two blocs side by side, and the table to the blocs closest to them.
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SourceLine from '../components/SourceLine.astro';
import '../styles/atlas/tools.css';
import '../styles/atlas/table.css';
import '../styles/atlas/filters.css';
import '../styles/atlas/country.css';
import '../styles/atlas/source.css';
import '../styles/atlas/explorer.css';
import '../styles/atlas/overlap.css';
import { OVERLAP_TEXT as T } from '../i18n/overlap.en';
import { bridges, overlapData } from '../lib/overlap';
import { DEFAULTS } from '../lib/overlap/model';
import { bridgeHtml, chipsHtml, matrixHtml, phoneTableHtml, tableHtml, twoHtml } from '../lib/overlap/render';
import { paths } from '../lib/routes';
import { breadcrumbs } from '../lib/structured';

const data = overlapData();
const state = DEFAULTS;
const crumbs = [{ label: T.crumb }, { label: T.title }];
const json = JSON.stringify({ data }).replace(/</g, '\\u003c');
---
<Page title={T.title} description={T.description(data.blocs.length)} hub="tools" container="tl" mainClass="gt-ov-tool" image={paths.image('tools', 'blocs-overlap')}
  jsonld={[breadcrumbs(crumbs)]}>
  <header class="gt-tlhead">
    <Breadcrumbs items={crumbs} />
    <h1 class="gt-title gt-tlhead__t">{T.title}</h1>
    <p class="gt-lede gt-tlhead__a">{T.lede}</p>
    <SourceLine source={T.source} parts={[T.checked(data.checkedText)]} />
    <p class="gt-caption">{T.note}</p>
  </header>
  <div class="gt-presets gt-ovdesk" role="group" aria-labelledby="o-chips-l" data-o-chips set:html={chipsHtml(state, data)} />
  <div class="gt-indgrid gt-indgrid--bl">
    <section class="gt-tlsec gt-ovdesk" data-o-matrix set:html={matrixHtml(state, data)} />
    <section class="gt-two gt-ovphone" aria-label={T.title} data-o-two set:html={twoHtml(state, data)} />
    <section class="gt-tlsec gt-bridge" set:html={bridgeHtml(bridges(), data)} />
  </div>
  <section class="gt-tlsec gt-ovdesk" data-o-table set:html={tableHtml(state, data)} />
  <section class="gt-tlsec gt-ovphone" data-o-ptable set:html={phoneTableHtml(state, data)} />
  <script type="application/json" id="o-data" set:html={json} />
</Page>

<script>
  import { initOverlap } from '../scripts/overlap';
  initOverlap();
</script>
