---
// A map view on a registry measure (emissions, refugees), on the same template as the minerals views: the answer in
// one sentence, the layer picker, year slider and bloc outline, the map with its legend and panel, then the
// summary, every country and related links. All text, figures and the table are in the HTML; the map
// (src/scripts/map/) loads after them and only on demand on phones.
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SourceLine from '../components/SourceLine.astro';
import Notice from '../components/Notice.astro';
import ShareRow from '../components/ShareRow.astro';
import MapStage from '../components/MapStage.astro';
import MapControls from '../components/MapControls.astro';
import Icon from '../components/Icon.astro';
import '../styles/atlas/mapview.css';
import '../styles/atlas/bars.css';
import '../styles/atlas/keyfigure.css';
import '../styles/atlas/table.css';
import '../styles/atlas/tools.css';
import { MAP_TEXT } from '../i18n/map.en';
import { EXCHANGE_TEXT as EX, PARTS_TEXT as PX, VIEW_TEXT, VIEWS_TEXT as W } from '../i18n/views.en';
import { changeSize, changeText, coverageBreak, diffText, flat, placeChange, creditOf, familyPages, legendOf, lede, partsOf, placeNote, shareOf, summary, yearNote, unreportedIn, unreportedText, valueText, viewPage, worldChange, indicatorLabel, prevOf, yearText } from '../lib/views';
import { refreshed } from '../lib/data';
import { formatValue } from '../lib/format';
import { place } from '../lib/places';
import { countryHref, indicatorHref, live, route, hubCrumb, viewHref } from '../lib/routes';
import { layerPath } from '../lib/map/layers';
import { breadcrumbs } from '../lib/structured';
import { byYear } from '../lib/map/by-year';
import { asOfDate } from '../lib/as-of';
import type { Row } from '../lib/stats';
import { constellations, sitesIn, spaceAsOf } from '../lib/space';
import { exchangeList, unplaced } from '../lib/exchanges';
import { SPACE_TEXT as SP } from '../i18n/space.en';
import { CHIP_LAYERS, chipFlowsFor, clustersAt } from '../lib/ai';
import { AI_TEXT as AX } from '../i18n/ai.en';
import { capacityText, gdwNamesNote, largeDams } from '../lib/dams';
import { largestProjects } from '../lib/lending';
import { DAMS_TEXT as DX, LENDING_TEXT as LX, RIVERS_TEXT as RV } from '../i18n/water.en';
import { riverIds } from '../lib/rivers';
import { formatDate } from '../lib/format';
import { armsPeriod, armsPeriods } from '../lib/arms';
import { ARMS_TEXT as RX } from '../i18n/arms.en';
import { groupsOf, worldMix } from '../lib/electricity';
import { areaAt, areaLabel, catastrophe, foodTags, ipcDay, monthSpan, ofAnalysed, ofAnalysedAt, periodAt } from '../lib/hunger';
import AreaTag from '../components/AreaTag.astro';
import FigureLabels from '../components/FigureLabels.astro';
import { HUNGER_TEXT as HG } from '../i18n/hunger.en';
import { POWER_TEXT as PW } from '../i18n/electricity.en';
import { basesOf, cyberData, ownState, pairs as cyberPairs } from '../lib/cyber';
import { CYBER_TEXT as CX } from '../i18n/cyber.en';
import { OTHER_SUPPLIER } from '../adapters/sipri';
import { DEP_TEXT } from '../i18n/pages.en';

interface Props { id: string }
const p = viewPage(Astro.props.id)!;
const T = p.text;
const fam = VIEW_TEXT[p.family.id];
const key = (id: string) => `view:${p.family.id}:${id}`;
const path = route(key(p.id))!.path;
const url = new URL(path, Astro.site).href;
const source = creditOf(p);
const updated = refreshed([p.loaded.indicator.source].flat()[0]);
// IPC: the day the site fetched its data, kept apart from the date in its credit (the day its analyses last changed).
const updatedLabel = p.family.id === 'food-crises' ? HG.lastFetched : undefined;
const y = p.byYear[p.year];
const answer = lede(p);
const nameOf = (id: string) => place(id)?.name ?? (id === OTHER_SUPPLIER ? DEP_TEXT.otherSuppliers : id);
const when = T.period ? T.period(p.year) : String(p.year);
const yearsText = p.layer.span ? `${p.years[0] - p.layer.span + 1}–${p.year}` : p.years.length > 1 ? `${p.years[0]}–${p.years.at(-1)}` : when;
const crumbs: { label: string; href?: string }[] = [hubCrumb(p.family.hub), { label: fam.section, href: viewHref(p.family.id) }, { label: T.title }];
const div = p.layer.scale === 'div';
const pct = (ch: number) => changeText(p, ch);
const food = p.family.id === 'food-crises';

// The table: every country with a figure for a year, the year before and the change. One table for the default year;
// on the food crises views one for each year, shown with the year control, since their figures move with it.
const count = (v: number) => formatValue(v, { kind: 'count' });
const unreportedLabel = unreportedText(p)?.label;
function tableFor(yr: number) {
  const Y = p.byYear[yr];
  const before = p.years.includes(prevOf(p, yr)) ? p.byYear[prevOf(p, yr)] : null;
  const rows = Y.rows.map((r) => {
    const q = before?.rows.find((x) => x.id === r.id);
    // Shares of a country's own total (electricity) change in percentage points.
    const ch = div || !q ? null : placeChange(p, r.value, q.value);
    // Food crises: analyses of different populations give no change (Yemen nationwide in 2025, its south in 2026).
    const broken = !!q && coverageBreak(p, r.id, yr);
    // Small counts (cyber incidents under 10) change by a number of incidents, not a percentage.
    const diff = div || !q ? null : diffText(p, r.value, q.value);
    return { r, q, ch, diff, broken, parts: partsOf(p, r.id, yr) };
  });
  // Refugees: the three groups UNHCR adds together, as columns; notes on single countries, numbered under the table.
  const hasParts = p.layer.sums && rows.some((x) => x.parts);
  // A place's own note, then any for the table's year only (a grid operator's figure beside Ember's).
  const notes = rows.map((x) => ({ id: x.r.id, text: [placeNote(p, x.r.id, !hasParts), yearNote(p, x.r.id, yr)].filter(Boolean).join(' ') })).filter((n) => !!n.text);
  // Places not reported this year (src/data/not-reported.ts): a row after the others, with the words and no figure.
  const unreported = unreportedIn(p, yr).map((n) => n.place);
  for (const id of unreported) {
    const text = placeNote(p, id, false);
    if (text && !notes.some((n) => n.id === id)) notes.push({ id, text });
  }
  const noteNo = (id: string) => notes.findIndex((n) => n.id === id) + 1;
  // Note anchors are unique on the page: one set per table.
  const noteId = (n: number) => (yr === p.year ? `mv-note-${n}` : `mv-note-${yr}-${n}`);
  return { yr, Y, prev: before, rows, hasParts, notes, unreported, noteNo, noteId };
}
const tables = (food ? p.years : [p.year]).map(tableFor);
const top = y.rows.slice(0, 3);
const related = [
  ...(indicatorHref(p.id) ? [{ href: indicatorHref(p.id)!, name: indicatorLabel(p), note: W.indicatorPage }] : []),
  ...top.filter((r) => countryHref(r.id)).map((r) => ({ href: countryHref(r.id)!, name: nameOf(r.id), note: W.countryPage })),
  ...familyPages(p.family.id).filter((o) => o.id !== p.id && live(key(o.id))).slice(0, 2).map((o) => ({ href: live(key(o.id))!.path, name: o.text.title, note: W.sameView })),
];
// The headline, the map's label, the summary and their source lines follow the year control; the table stays on the default year.
const mapLabel = (yr: number) => {
  const rs = p.byYear[yr].rows;
  const top = (div ? [...rs.slice(0, 2), ...rs.slice(-2)] : rs.slice(0, 3)).map((r) => `${nameOf(r.id)} ${valueText(p, r.value)}`).join(', ');
  return `${legendOf(p, yr)}. ${top}. ${W.caption(yr, null)}`;
};
// A still-running year counted on one day (satellites) says "as of {date}" (src/lib/as-of.ts).
const sourceYears = p.years.map((yr) => ({ year: yr, parts: [asOfDate(p.loaded.indicator.id, yr) ? `as of ${asOfDate(p.loaded.indicator.id, yr)}` : p.family.id === 'food-crises' ? HG.covers(yr) : yearText(p, yr)] }));
// Space: the largest constellations (satellites) or the launch sites (launches), under the country table.
const cons = p.id === 'satellites' ? constellations() : [];
// Electricity: the world's power mix in the default year, under the country table.
const wmix = p.family.id === 'electricity' ? worldMix(p.year) : null;
// Food crises: countries whose analysis in force on the snapshot's day counts people in catastrophe.
const cat = p.family.id === 'food-crises' ? catastrophe() : [];
// Food crises: what sits beside each figure (FigureLabels): its tags, the area its analysis covers ("Gaza Strip only")
// and the people an analysis of part of the country covered.
const labelsOf = (id: string, yr: number) => (food ? { tags: foodTags(id, yr), area: areaAt(id, yr), of: ofAnalysedAt(id, yr), period: periodAt(id, yr) } : null);
const labelled = (l: ReturnType<typeof labelsOf>) => !!l && (l.tags.length > 0 || !!l.area || !!l.of || !!l.period);
// Chips: the year's largest flows, supplier to buyer.
const chipFlows = CHIP_LAYERS[p.id] ? chipFlowsFor(p.id, p.year).slice(0, 20) : [];
const twh = (v: number) => formatValue(v, { kind: 'number', digits: v < 10 ? 1 : 0 });
const sites = p.id === 'launches' ? sitesIn(p.year) : [];
// Exchange points: the exchanges with the most networks connected.
const ixps = p.id === 'exchanges' ? exchangeList().slice(0, 20) : [];
const clusters = p.id === 'aicompute' ? clustersAt(p.year).slice(0, 20) : [];
const dams = p.id === 'waterstress' ? largeDams().slice(0, 20) : [];
const projects = p.family.id === 'chinese-lending' ? largestProjects(20, p.id === 'lendall' ? null : p.id.slice(4)) : [];
const money = (v: number) => formatValue(v, { kind: 'money' });
// Water: the disputed river pages.
const rivers = p.family.id === 'water' ? riverIds().filter((r) => live(`view:rivers:${r}`)).map((r) => ({ href: live(`view:rivers:${r}`)!.path, name: RV.name[r] ?? r })) : [];
// Arms: the largest flows of the period, with each flow's share of what the recipient imported.
const armsNow = p.family.id === 'arms' ? armsPeriods().find((x) => x.end === p.year)?.pairs ?? [] : [];
const flows = armsNow.slice(0, 20).map((x) => {
  const into = armsNow.filter((q) => q.to === x.to).reduce((t, q) => t + q.amount, 0);
  return { ...x, share: into ? formatValue(x.amount / into, { kind: 'share' }) : '' };
});
const tiv = (v: number) => formatValue(v, { kind: 'number' });
// Cyber incidents: the year's state and country pairs with the most incidents, with who attributed them.
const cyber = p.id === 'cyber' ? cyberData() : null;
// A state's incidents in its own country are not a pair between countries, so they stay in the panel only.
const attributions = cyber ? cyberPairs(cyber, p.year).filter((x) => !ownState(x)).slice(0, 20) : [];
const spaceDate = spaceAsOf() ? formatDate(spaceAsOf()!) : '';
const bars = (rs: Row[], max: number, yr: number) => rs.map((r) => ({ id: r.id, text: valueText(p, r.value), w: max ? (100 * Math.abs(r.value)) / max : 0, labels: labelsOf(r.id, yr) }));
---
<Page title={T.title} description={T.description(p.year)} hub={p.family.hub} container="mv" image={route(key(p.id))!.image}
  jsonld={[breadcrumbs(crumbs.map((c) => ({ label: c.label, href: c.href })))]}>
  <div class="gt-mvhead">
    <Breadcrumbs items={crumbs} />
    <h1 class="gt-title gt-mvhead__t">{T.title} <span class="gt-mvhead__sub">{T.sub}</span></h1>
    <p class="gt-lede gt-mvhead__a" data-headline data-by-year={byYear(p.years, (yr) => lede(p, yr))} hidden={!answer}>{answer}</p>
    <SourceLine source={source} years={sourceYears} year={p.year} updated={updated} updatedLabel={updatedLabel} />
  </div>

  <MapControls
    pickerLabel={fam.pickerLabel}
    picker={familyPages(p.family.id).filter((o) => live(key(o.id))).map((o) => ({ label: o.text.pick, href: live(key(o.id))!.path, current: o.id === p.id }))}
    years={p.years} year={p.year}
    periods={p.layer.span ? { label: W.periodLabel(p.layer.span), options: Object.fromEntries(p.years.map((yr) => [yr, yearText(p, yr)])) } : undefined} />

  <MapStage layer={layerPath(`${p.family.id}-${p.id}`)} label={mapLabel(p.year)} labels={byYear(p.years, mapLabel)} title={T.title}
    legend={{ title: legendOf(p, p.year), scale: p.layer.scale, ticks: p.ticks, ends: T.ends, none: T.none ?? fam.none ?? W.noData, ...(food ? { partial: HG.partialLegend } : {}), ...(unreportedIn(p, p.year).length ? { withheld: unreportedLabel } : {}), ...(p.id === 'launches' ? { marks: [{ symbol: 'hollow', label: SP.sitesMark }] } : p.id === 'exchanges' ? { marks: [{ symbol: 'hollow', label: EX.mark }] } : p.id === 'aicompute' ? { marks: [{ symbol: 'hollow', label: AX.mark }] } : p.id === 'waterstress' ? { marks: [{ symbol: 'triangle', label: DX.mark }] } : CHIP_LAYERS[p.id] ? { marks: [{ symbol: 'arc', label: AX.arcs }] } : p.id === 'cyber' ? { marks: [{ symbol: 'arc', label: CX.arcs }] } : {}) }}>
    <div data-panel="world" slot="panel">
      <div class="gt-panel__head">
        <div class="gt-panel__title"><span class="gt-kicker">{T.title} · <span data-year-text>{when}</span></span><h2 class="gt-h3">{T.worldHeading ?? MAP_TEXT.world}</h2></div>
      </div>
      <div class="gt-panel__body">
        {p.years.map((yr) => {
          const Y = p.byYear[yr];
          const ch = worldChange(p, yr);
          const max = Math.max(...Y.rows.map((r) => Math.abs(r.value)));
          const groups = div
            ? [{ label: W.importers, items: bars(Y.rows.filter((r) => r.value > 0).slice(0, 5), max, yr) }, { label: W.exporters, items: bars(Y.rows.filter((r) => r.value < 0).reverse().slice(0, 5), max, yr) }]
            : [{ label: T.barsLabel ?? W.highest, items: bars(Y.rows.slice(0, 8), max, yr) }];
          return (
            <div class="gt-pyear" data-year={yr} hidden={yr !== p.year}>
              {Y.world !== null && T.worldLabel && (
                <div class="gt-pkf">
                  <span class="gt-pkf__label">{T.worldLabel}</span>
                  <span class="gt-pkf__num">{valueText(p, Y.world)}</span>
                  {T.totalOf?.caveat && <span class="gt-pkf__meta">{T.totalOf.caveat}</span>}
                  {ch !== null && p.id !== 'co2cum' && (Y.world || p.layer.points) && (
                    <span class="gt-pkf__meta"><span class="gt-kf__change"><Icon name={flat(p, ch) ? 'flat' : ch > 0 ? 'up' : 'down'} />{flat(p, ch) ? W.sameAs(yearText(p, prevOf(p, yr))) : W.change2(changeSize(p, ch), ch > 0, yearText(p, prevOf(p, yr)), valueText(p, p.byYear[prevOf(p, yr)].world!))}</span></span>
                  )}
                </div>
              )}
              {groups.map((g) => g.items.length > 0 && (
                <div class="gt-pgroup">
                  <span class="gt-label">{g.label}</span>
                  <ol class="gt-bars gt-bars--tight" aria-label={`${g.label}, ${T.figureLabel.toLowerCase()}, ${yr}`}>
                    {g.items.map((x) => (
                      <li><span class="gt-bars__name"><button type="button" data-select={x.id}>{nameOf(x.id)}</button></span><span class="gt-bars__track"><span class="gt-bars__fill" style={`width:${x.w.toFixed(1)}%`}></span></span><span class="gt-bars__val">{x.text}</span>{labelled(x.labels) && <span class="gt-bars__note"><FigureLabels {...x.labels!} /></span>}</li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          );
        })}
        <div class="gt-blocline" hidden><span class="gt-blocline__key" aria-hidden="true"></span><p></p></div>
        <Notice>
          <p>{T.caveat}</p>
          <SourceLine source={source} parts={[yearsText]} updated={updated} updatedLabel={updatedLabel} />
        </Notice>
      </div>
    </div>
  </MapStage>

  <section class="gt-mvbelow" aria-labelledby="mv-sum">
    <div class="gt-mvbelow__main">
      <h2 class="gt-h2" id="mv-sum">{W.summary}</h2>
      <div class="gt-prose" data-by-year={byYear(p.years, (yr) => summary(p, yr))}>{summary(p).map((s) => <p>{s}</p>)}</div>
      <SourceLine source={source} years={sourceYears} year={p.year} updated={updated} updatedLabel={updatedLabel} />
      <h2 class="gt-h2" id="table">{W.table}</h2>
      {tables.map((t) => (
        <div class="gt-mvyear" data-for-year={food ? t.yr : undefined} hidden={t.yr !== p.year}>
      <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={W.tableLabel(T.title)}>
        <table class="gt-table" data-gt-sort>
          <caption class="gt-caption">{W.caption(t.yr, t.prev?.year ?? null)}{T.totalOf?.caveat && ` ${T.totalOf.caveat}`}</caption>
          <thead><tr>
            <th scope="col" data-key="n"><button type="button">{W.country}</button></th>
            <th scope="col" class="n" data-key="v" data-type="num" aria-sort="descending"><button type="button">{yearText(p, t.yr)}</button></th>
            {p.layer.sums && <th scope="col" class="n" data-key="s" data-type="num"><button type="button">{T.totalOf?.column ?? W.share}</button></th>}
            {t.prev && <th scope="col" class="n" data-key="q" data-type="num"><button type="button">{yearText(p, t.prev.year)}</button></th>}
            {t.prev && !div && <th scope="col" class="n" data-key="c" data-type="num"><button type="button">{W.change}</button></th>}
            {t.hasParts && <th scope="col" class="n" data-key="pr" data-type="num"><button type="button">{PX.refugees}</button></th>}
            {t.hasParts && <th scope="col" class="n" data-key="pa" data-type="num"><button type="button">{PX.asylum}</button></th>}
            {t.hasParts && <th scope="col" class="n" data-key="po" data-type="num"><button type="button">{PX.oipShort}</button></th>}
          </tr></thead>
          <tbody>
            {t.rows.map(({ r, q, ch, diff, broken, parts }) => (
              <tr data-place={r.id}>
                <th scope="row">{countryHref(r.id) ? <a href={countryHref(r.id)}>{nameOf(r.id)}</a> : nameOf(r.id)}{t.noteNo(r.id) > 0 && <sup class="gt-fn"><a href={`#${t.noteId(t.noteNo(r.id))}`} aria-label={`${W.notes} ${t.noteNo(r.id)}`}>{t.noteNo(r.id)}</a></sup>}</th>
                <td class="n" data-v={r.value}>{valueText(p, r.value)}{labelled(labelsOf(r.id, t.yr)) && <FigureLabels {...labelsOf(r.id, t.yr)!} block />}</td>
                {p.layer.sums && <td class="n" data-v={t.Y.world ? r.value / t.Y.world : ''}>{shareOf(r.value, t.Y.world) ?? '–'}</td>}
                {t.prev && (q ? <td class="n" data-v={q.value}>{valueText(p, q.value)}</td> : <td class="n gt-na" data-v="">–</td>)}
                {t.prev && !div && (broken ? <td class="n gt-muted" style="white-space:normal;min-width:6em" data-v="">{HG.coverageChanged}</td> : ch === null ? <td class="n gt-na" data-v="">–</td> : <td class="n" data-v={ch}><span class="gt-chg"><Icon name={flat(p, ch) ? 'flat' : ch > 0 ? 'up' : 'down'} />{diff ?? pct(ch)}</span></td>)}
                {t.hasParts && (parts ? [parts.refugees, parts.asylum, parts.oip].map((v) => <td class="n" data-v={v}>{count(v)}</td>) : [0, 1, 2].map(() => <td class="n gt-na" data-v="">–</td>))}
              </tr>
            ))}
            {t.unreported.map((id) => (
              <tr data-place={id}>
                <th scope="row">{countryHref(id) ? <a href={countryHref(id)}>{nameOf(id)}</a> : nameOf(id)}{t.noteNo(id) > 0 && <sup class="gt-fn"><a href={`#${t.noteId(t.noteNo(id))}`} aria-label={`${W.notes} ${t.noteNo(id)}`}>{t.noteNo(id)}</a></sup>}</th>
                <td class="n gt-na" data-v="">{unreportedLabel}</td>
                {p.layer.sums && <td class="n gt-na" data-v="">–</td>}
                {t.prev && <td class="n gt-na" data-v="">{t.prev.rows.some((x) => x.id === id) ? valueText(p, t.prev.rows.find((x) => x.id === id)!.value) : '–'}</td>}
                {t.prev && !div && <td class="n gt-na" data-v="">–</td>}
                {t.hasParts && [0, 1, 2].map(() => <td class="n gt-na" data-v="">–</td>)}
              </tr>
            ))}
          </tbody>
          {t.Y.world !== null && p.layer.sums && (
            <tfoot><tr>
              <td>{t.Y.worldOwn ? W.worldRow : T.totalOf?.row ?? W.totalRow}</td><td class="n">{valueText(p, t.Y.world!)}</td><td class="n">100%</td>
              {t.prev && <td class="n">{t.prev.world !== null ? valueText(p, t.prev.world) : '–'}</td>}
              {t.prev && <td class="n">{worldChange(p, t.yr) !== null && p.id !== 'co2cum' ? pct(worldChange(p, t.yr)!) : '–'}</td>}
              {t.hasParts && (['refugees', 'asylum', 'oip'] as const).map((k) => <td class="n">{count(t.rows.reduce((t, x) => t + (x.parts?.[k] ?? 0), 0))}</td>)}
            </tr></tfoot>
          )}
        </table>
      </div>
      <SourceLine source={source} parts={[t.prev ? `${t.prev.year} and ${t.yr}` : yearText(p, t.yr)]} updated={updated} updatedLabel={updatedLabel} />
      {t.notes.length > 0 && (
        <div class="gt-mvnotes">
          <h3 class="gt-label">{W.notes}</h3>
          <ol class="gt-caption">{t.notes.map((n, i) => <li id={t.noteId(i + 1)}><b>{nameOf(n.id)}:</b> {n.text}</li>)}</ol>
        </div>
      )}
        </div>
      ))}
      {attributions.length > 0 && (
        <>
          <h2 class="gt-h2" id="attributions">{CX.pairs}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={CX.pairs}>
            <table class="gt-table">
              <caption class="gt-caption">{CX.pairsCaption(attributions.length, p.year)}</caption>
              <thead><tr>
                <th scope="col"><span class="gt-th">{CX.state}</span></th><th scope="col"><span class="gt-th">{CX.country}</span></th>
                <th scope="col" class="n"><span class="gt-th">{CX.incidents}</span></th>
              </tr></thead>
              <tbody>{attributions.map((x) => <tr><td>{nameOf(x.from)}</td><th scope="row">{nameOf(x.to)}<small class="gt-caption" style="display:block;font-weight:400">{CX.by(basesOf(x.by))}</small></th><td class="n">{count(x.n)}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="gt-caption">{CX.caveat}</p>
          <SourceLine source={source} parts={[String(p.year)]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {chipFlows.length > 0 && (
        <>
          <h2 class="gt-h2" id="flows">{AX.flows}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:none" tabindex="0" role="region" aria-label={AX.flows}>
            <table class="gt-table">
              <caption class="gt-caption">{AX.flowsCaption(chipFlows.length, p.year)}</caption>
              <thead><tr><th scope="col">{AX.from}</th><th scope="col">{AX.to}</th><th scope="col" class="n">{AX.value}</th></tr></thead>
              <tbody>{chipFlows.map((f) => <tr><td>{nameOf(f.from)}</td><th scope="row">{nameOf(f.to)}</th><td class="n">{money(f.amount)}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={[String(p.year)]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {cat.length > 0 && (
        <>
          <h2 class="gt-h2" id="phase5">{HG.catastrophe}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:none" tabindex="0" role="region" aria-label={HG.catastrophe}>
            <table class="gt-table">
              <caption class="gt-caption">{HG.catastropheCaption(formatDate(ipcDay()))}</caption>
              <thead><tr><th scope="col">{HG.country}</th><th scope="col">{HG.period}</th><th scope="col" class="n">{HG.people5}</th><th scope="col" class="n">{HG.people3}</th></tr></thead>
              <tbody>{cat.map((a) => <tr><th scope="row">{countryHref(a.place) ? <a href={countryHref(a.place)}>{nameOf(a.place)}</a> : nameOf(a.place)}{areaLabel(a) && <> <AreaTag label={areaLabel(a)!} /></>}</th><td>{HG.label(a.system, a.period, monthSpan(a.from, a.to))}</td><td class="n">{count(a.phases[4])}{ofAnalysed(a) && <small>{ofAnalysed(a).trim()}</small>}</td><td class="n">{count(a.crisis)}{ofAnalysed(a) && <small>{ofAnalysed(a).trim()}</small>}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {wmix && (
        <>
          <h2 class="gt-h2" id="mix">{PW.worldMix}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:none" tabindex="0" role="region" aria-label={PW.worldMix}>
            <table class="gt-table">
              <caption class="gt-caption">{PW.worldMixCaption(p.year, wmix.own)}</caption>
              <thead><tr><th scope="col">{PW.source}</th><th scope="col" class="n">{PW.twh}</th><th scope="col" class="n">{PW.share}</th></tr></thead>
              <tbody>{groupsOf(wmix.mix).map((g) => <tr><th scope="row">{PW.group[g.group]}</th><td class="n">{twh(g.twh)}</td><td class="n">{formatValue(g.share, { kind: 'share' })}</td></tr>)}</tbody>
              <tfoot><tr><td>{PW.total}</td><td class="n">{twh(wmix.mix.total)}</td><td class="n">100%</td></tr></tfoot>
            </table>
          </div>
          <SourceLine source={source} parts={[String(p.year)]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {cons.length > 0 && (
        <>
          <h2 class="gt-h2" id="constellations">{SP.constellations}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:none" tabindex="0" role="region" aria-label={SP.constellations}>
            <table class="gt-table">
              <caption class="gt-caption">{SP.constellationsCaption(spaceDate)}</caption>
              <thead><tr><th scope="col"><span class="gt-th">{SP.constellation}</span></th><th scope="col"><span class="gt-th">{SP.owner}</span></th><th scope="col" class="n"><span class="gt-th">{SP.count}</span></th></tr></thead>
              <tbody>{cons.map((c) => <tr><th scope="row">{SP.names[c.id] ?? c.id}</th><td>{c.place ? nameOf(c.place) : SP.intl}</td><td class="n">{count(c.active)}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={[spaceDate]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {clusters.length > 0 && (
        <>
          <h2 class="gt-h2" id="clusters">{AX.largest}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={AX.largest}>
            <table class="gt-table">
              <caption class="gt-caption">{AX.largestCaption(clusters.length, p.year)}</caption>
              <thead><tr>
                <th scope="col"><span class="gt-th">{AX.name}</span></th><th scope="col"><span class="gt-th">{AX.country}</span></th>
                <th scope="col" class="n"><span class="gt-th">{AX.power}</span></th><th scope="col" class="n"><span class="gt-th">{AX.since}</span></th>
              </tr></thead>
              <tbody>{clusters.map((c) => <tr><th scope="row">{c.name}{c.owner && <small class="gt-caption" style="display:block">{c.owner}</small>}</th><td>{nameOf(c.place)}</td><td class="n">{count(c.h100e)}</td><td class="n">{c.start.slice(0, 4)}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={[String(p.year)]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {dams.length > 0 && (
        <>
          <h2 class="gt-h2" id="dams">{DX.largest}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={DX.largest}>
            <table class="gt-table">
              <caption class="gt-caption">{DX.largestCaption(dams.length)}</caption>
              <thead><tr>
                <th scope="col"><span class="gt-th">{DX.dam}</span></th><th scope="col"><span class="gt-th">{DX.river}</span></th><th scope="col"><span class="gt-th">{DX.country}</span></th>
                <th scope="col" class="n"><span class="gt-th">{DX.capacity}</span></th><th scope="col" class="n"><span class="gt-th">{DX.year}</span></th>
              </tr></thead>
              <tbody>{dams.map((d) => <tr><th scope="row">{d.name}</th><td>{d.river}</td><td>{d.place ? nameOf(d.place) : ''}</td><td class="n">{capacityText(d)}</td><td class="n">{d.year ?? '–'}</td></tr>)}</tbody>
            </table>
          </div>
          {gdwNamesNote(dams) && <p class="gt-caption">{gdwNamesNote(dams)}</p>}
          <SourceLine source={DX.source} parts={[]} />
        </>
      )}
      {projects.length > 0 && (
        <>
          <h2 class="gt-h2" id="projects">{LX.largest}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={LX.largest}>
            <table class="gt-table">
              <caption class="gt-caption">{LX.largestCaption(projects.length)}</caption>
              <thead><tr>
                <th scope="col"><span class="gt-th">{LX.project}</span></th><th scope="col"><span class="gt-th">{LX.country}</span></th>
                <th scope="col" class="n"><span class="gt-th">{LX.amount}</span></th><th scope="col" class="n"><span class="gt-th">{LX.year}</span></th>
              </tr></thead>
              <tbody>{projects.map((x) => <tr><th scope="row" style="font-weight:400">{x.title}</th><td>{nameOf(x.place)}</td><td class="n">{money(x.amount)}</td><td class="n">{x.year}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={['2000–2021']} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {flows.length > 0 && (
        <>
          <h2 class="gt-h2" id="flows">{RX.largest}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={RX.largest}>
            <table class="gt-table">
              <caption class="gt-caption">{RX.largestCaption(flows.length, armsPeriod(p.year))}</caption>
              <thead><tr>
                <th scope="col"><span class="gt-th">{RX.supplier}</span></th><th scope="col"><span class="gt-th">{RX.recipient}</span></th>
                <th scope="col" class="n"><span class="gt-th">{RX.amount}</span></th><th scope="col" class="n"><span class="gt-th">{RX.share}</span></th>
              </tr></thead>
              <tbody>{flows.map((x) => <tr><th scope="row">{nameOf(x.from)}</th><td>{nameOf(x.to)}</td><td class="n">{tiv(x.amount)}</td><td class="n">{x.share}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={[armsPeriod(p.year)]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {ixps.length > 0 && (
        <>
          <h2 class="gt-h2" id="exchanges">{EX.largest}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:560px" tabindex="0" role="region" aria-label={EX.largest}>
            <table class="gt-table">
              <caption class="gt-caption">{EX.largestCaption(ixps.length, unplaced())}</caption>
              <thead><tr>
                <th scope="col"><span class="gt-th">{EX.exchange}</span></th><th scope="col"><span class="gt-th">{EX.country}</span></th>
                <th scope="col" class="n"><span class="gt-th">{EX.networks}</span></th>
              </tr></thead>
              <tbody>{ixps.map((x) => <tr><th scope="row">{x.name}{x.city && <small class="gt-caption" style="display:block">{x.city}</small>}</th><td>{nameOf(x.place)}</td><td class="n">{count(x.networks)}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={[when]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
      {sites.length > 0 && (
        <>
          <h2 class="gt-h2" id="sites">{SP.sites}</h2>
          <div class="gt-tablewrap" style="--gt-table-h:none" tabindex="0" role="region" aria-label={SP.sites}>
            <table class="gt-table" data-gt-sort>
              <caption class="gt-caption">{SP.sitesCaption(p.year)}</caption>
              <thead><tr>
                <th scope="col" data-key="n"><button type="button">{SP.site}</button></th>
                <th scope="col" data-key="c"><button type="button">{SP.country}</button></th>
                <th scope="col" class="n" data-key="v" data-type="num" aria-sort="descending"><button type="button">{p.year}</button></th>
                <th scope="col" class="n" data-key="t" data-type="num"><button type="button">{SP.since}</button></th>
              </tr></thead>
              <tbody>{sites.map((x) => <tr><th scope="row">{x.name}</th><td>{x.place ? nameOf(x.place) : SP.intl}</td><td class="n" data-v={x.n}>{count(x.n)}</td><td class="n" data-v={x.total}>{count(x.total)}</td></tr>)}</tbody>
            </table>
          </div>
          <SourceLine source={source} parts={[String(p.year)]} updated={updated} updatedLabel={updatedLabel} />
        </>
      )}
    </div>
    <aside class="gt-mvbelow__side">
      <h2 class="gt-label">{W.related}</h2>
      <ul class="gt-related">{related.map((r) => <li><a href={r.href}><span>{r.name}</span><small>{r.note}</small></a></li>)}</ul>
      {rivers.length > 0 && (
        <>
          <h2 class="gt-label">{RV.section}</h2>
          <ul class="gt-related">{rivers.map((r) => <li><a href={r.href}><span>{r.name}</span></a></li>)}</ul>
        </>
      )}
      <div class="gt-mvbelow__share"><ShareRow url={url} text={answer ?? T.title} /></div>
    </aside>
  </section>
</Page>

<script>
  import { initSortable } from '../scripts/table';
  document.querySelectorAll<HTMLTableElement>('table[data-gt-sort]').forEach(initSortable);
</script>
