// Cloudflare Worker that serves the built site (dist/) as static assets.
// Requests under /api/ run worker/index.ts first; everything else is a file from dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geopolitics-tools",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
