// Cloudflare Worker that serves the built site (dist/) as static assets.
// Every request runs worker/index.ts first: it answers /api/, keeps the domain on the holding page until launch,
// and hands everything else to the files from dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geopolitics-tools",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  // The production domain (its DNS zone is on this Cloudflare account). The first deploy with it creates the DNS
  // record and certificate; it stops with an error, changing nothing, if another record already uses the name.
  // workers.dev stays on for CI checks; it is noindex like everything else until launch.
  "routes": [{ "pattern": "geopolitics.tools", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Hourly outside watch of the data pipeline (worker/watch.ts): starts a run if GitHub skipped one,
  // alerts if status.json goes stale. Secrets GH_DISPATCH_TOKEN, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
  // are set by the production deploy from the repository secrets.
  "triggers": { "crons": ["41 * * * *"] },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "gt-snapshots" }],
  // Branch Previews (wrangler preview). They inherit nothing from production, so add bindings here as they arrive.
  "previews": {}
}
