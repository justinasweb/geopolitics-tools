{
  "name": "geopolitics-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.mjs",
    "build:fast": "GT_FAST=1 astro build",
    "serve": "wrangler dev --port 8787",
    "serve:fast": "npm run build:fast && npm run serve",
    "lint": "eslint .",
    "typecheck": "astro check && tsc -p worker",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "qa:a11y": "node tests/qa/a11y.mjs",
    "qa:keyboard": "node tests/qa/keyboard.mjs",
    "qa:speed": "node tests/qa/speed.mjs",
    "qa:phone": "node tests/qa/phone.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:sample": "GT_DATA=sample astro build && ALLOW_SAMPLE=1 node scripts/check-dist.mjs",
    "data:pull": "node --env-file-if-exists=.env pipeline/pull.ts",
    "ai:status": "node scripts/ai.ts status",
    "ai:facts": "node scripts/ai.ts facts",
    "ai:draft": "node --env-file-if-exists=.env scripts/ai.ts draft",
    "ai:paste": "node scripts/ai.ts paste",
    "ai:own": "node scripts/ai.ts own",
    "ai:check": "node scripts/ai.ts check",
    "ai:approve": "node scripts/ai.ts approve",
    "ai:review": "node scripts/review.ts",
    "week:summary": "node --env-file-if-exists=.env scripts/week.ts summary",
    "week:digest": "node --env-file-if-exists=.env scripts/week.ts digest"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shuding/opentype.js": "1.4.0-beta.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.64.1",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0"
  }
}
