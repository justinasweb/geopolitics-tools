{
  "name": "geopolitics-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.mjs",
    "serve": "wrangler dev --port 8787",
    "lint": "eslint .",
    "typecheck": "astro check && tsc -p worker",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
